# Copy to the repo root as .env (gitignored) and fill in. Never commit real secrets.
MYOB_MODE=mock
MYOB_BASE_URL=http://127.0.0.1:8000
WAREHOUSE=duckdb                         # duckdb | snowflake

# --- OAuth: local issuer (default) ---
AUTH_MODE=local
MYOB_CLIENT_ID=mock-client-id
MYOB_CLIENT_SECRET=mock-client-secret

# --- OAuth: Auth0 (free plan), see docs/AUTH.md ---
# AUTH_MODE=auth0
# AUTH0_DOMAIN=dev-z1apvxcaj6hhb84a.us.auth0.com
# AUTH_AUDIENCE=https://myob-mock.dagostino-demo
# MYOB_CLIENT_ID=<Auth0 M2M client id>
# MYOB_CLIENT_SECRET=<Auth0 M2M client secret>

# --- Snowflake (WAREHOUSE=snowflake) ---
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
