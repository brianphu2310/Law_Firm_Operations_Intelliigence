table 'Period Balance'
	isHidden

	column Period
		dataType: string
		summarizeBy: none
		sourceColumn: Period

	column Role
		dataType: string
		summarizeBy: none
		sourceColumn: Role

	column ActiveMatters
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: ActiveMatters

	column ActiveMattersCount
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: ActiveMattersCount

	column Cash
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: Cash

	column WIP
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: WIP

	column Receivables
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: Receivables

	column Trust
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: Trust

	column DSO
		dataType: double
		formatString: #,0.0
		summarizeBy: none
		sourceColumn: DSO

	column Lockup
		dataType: double
		formatString: #,0.0
		summarizeBy: none
		sourceColumn: Lockup

	partition 'Period Balance' = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(BaseUrl, [RelativePath = "data/powerbi/period_balance.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"ActiveMatters", "ActiveMattersCount", "Cash", "WIP", "Receivables", "Trust", "DSO", "Lockup"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"Period", type text}, {"Role", type text}, {"ActiveMatters", type number}, {"ActiveMattersCount", type number}, {"Cash", type number}, {"WIP", type number}, {"Receivables", type number}, {"Trust", type number}, {"DSO", type number}, {"Lockup", type number}}, "en-US")
				in
				    Typed
