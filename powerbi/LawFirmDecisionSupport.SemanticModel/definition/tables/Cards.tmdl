table Cards

	column date
		dataType: dateTime
		formatString: dd mmm yyyy
		summarizeBy: none
		sourceColumn: date

	column card
		dataType: string
		summarizeBy: none
		sourceColumn: card

	column merchant
		dataType: string
		summarizeBy: none
		sourceColumn: merchant

	column category
		dataType: string
		summarizeBy: none
		sourceColumn: category

	column amount
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: amount

	column branch
		dataType: string
		summarizeBy: none
		sourceColumn: branch

	column country
		dataType: string
		summarizeBy: none
		sourceColumn: country

	partition Cards = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(BaseUrl, [RelativePath = "data/powerbi/cards.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"date", "amount"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"date", type date}, {"card", type text}, {"merchant", type text}, {"category", type text}, {"amount", type number}, {"branch", type text}, {"country", type text}}, "en-US")
				in
				    Typed
