table Marketing

	column channel
		dataType: string
		summarizeBy: none
		sourceColumn: channel

	column spend
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: spend

	column inquiries
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: inquiries

	column matters
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: matters

	column conversion
		dataType: double
		formatString: 0.0%;-0.0%;0.0%
		summarizeBy: none
		sourceColumn: conversion

	column fees
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: fees

	column cost_per_inquiry
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: cost_per_inquiry

	column cost_per_matter
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: cost_per_matter

	column fees_per_dollar
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: fees_per_dollar

	column fee_per_matter_firm
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: fee_per_matter_firm

	partition Marketing = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(BaseUrl, [RelativePath = "data/powerbi/marketing.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"spend", "inquiries", "matters", "conversion", "fees", "cost_per_inquiry", "cost_per_matter", "fees_per_dollar", "fee_per_matter_firm"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"channel", type text}, {"spend", type number}, {"inquiries", type number}, {"matters", type number}, {"conversion", type number}, {"fees", type number}, {"cost_per_inquiry", type number}, {"cost_per_matter", type number}, {"fees_per_dollar", type number}, {"fee_per_matter_firm", type number}}, "en-US")
				in
				    Typed
