table Commissions

	column matter
		dataType: string
		summarizeBy: none
		sourceColumn: matter

	column referrer
		dataType: string
		summarizeBy: none
		sourceColumn: referrer

	column rate_pct
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: rate_pct

	column amount
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: amount

	column status
		dataType: string
		summarizeBy: none
		sourceColumn: status

	partition Commissions = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(BaseUrl, [RelativePath = "data/powerbi/commissions.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"rate_pct", "amount"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"matter", type text}, {"referrer", type text}, {"rate_pct", type number}, {"amount", type number}, {"status", type text}}, "en-US")
				in
				    Typed
