table Period

	column Period
		dataType: string
		summarizeBy: none
		sourceColumn: Period
		sortByColumn: Order

	column Choice
		dataType: string
		summarizeBy: none
		sourceColumn: Choice

	column Order
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Order

	column Start
		dataType: dateTime
		formatString: dd mmm yyyy
		summarizeBy: none
		sourceColumn: Start

	column End
		dataType: dateTime
		formatString: dd mmm yyyy
		summarizeBy: none
		sourceColumn: End

	column PriorStart
		dataType: dateTime
		formatString: dd mmm yyyy
		summarizeBy: none
		sourceColumn: PriorStart

	column PriorEnd
		dataType: dateTime
		formatString: dd mmm yyyy
		summarizeBy: none
		sourceColumn: PriorEnd

	column Days
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Days

	column IsDefault
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: IsDefault

	column EndKey
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: EndKey

	column MonthEndKey
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: MonthEndKey

	partition Period = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(BaseUrl, [RelativePath = "data/powerbi/period.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"Order", "Start", "End", "PriorStart", "PriorEnd", "Days", "IsDefault", "EndKey", "MonthEndKey"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"Period", type text}, {"Choice", type text}, {"Order", Int64.Type}, {"Start", type date}, {"End", type date}, {"PriorStart", type date}, {"PriorEnd", type date}, {"Days", Int64.Type}, {"IsDefault", Int64.Type}, {"EndKey", Int64.Type}, {"MonthEndKey", Int64.Type}}, "en-US")
				in
				    Typed
