table Client

	column client_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: client_key

	column client_name
		dataType: string
		summarizeBy: none
		sourceColumn: client_name

	column primary_practice_area_key
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: primary_practice_area_key

	column relationship_attorney_key
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: relationship_attorney_key

	column client_since_year
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: client_since_year

	column country
		dataType: string
		summarizeBy: none
		sourceColumn: country

	column has_trust_account
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: has_trust_account

	partition Client = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(BaseUrl, [RelativePath = "data/warehouse/dim_client.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"client_key", "primary_practice_area_key", "relationship_attorney_key", "client_since_year", "has_trust_account"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"client_key", Int64.Type}, {"client_name", type text}, {"primary_practice_area_key", Int64.Type}, {"relationship_attorney_key", Int64.Type}, {"client_since_year", type number}, {"country", type text}, {"has_trust_account", type number}}, "en-US")
				in
				    Typed
