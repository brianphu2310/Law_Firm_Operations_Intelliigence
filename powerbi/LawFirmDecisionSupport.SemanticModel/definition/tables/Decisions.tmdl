table Decisions

	column Period
		dataType: string
		summarizeBy: none
		sourceColumn: Period

	column Order
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Order

	column Icon
		dataType: string
		summarizeBy: none
		sourceColumn: Icon

	column Colour
		dataType: string
		summarizeBy: none
		sourceColumn: Colour

	column Title
		dataType: string
		summarizeBy: none
		sourceColumn: Title

	column Detail
		dataType: string
		summarizeBy: none
		sourceColumn: Detail

	partition Decisions = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(BaseUrl, [RelativePath = "data/powerbi/decisions.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"Order"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"Period", type text}, {"Order", Int64.Type}, {"Icon", type text}, {"Colour", type text}, {"Title", type text}, {"Detail", type text}}, "en-US")
				in
				    Typed
