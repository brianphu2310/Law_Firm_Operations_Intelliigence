table 'Sim Lever Test'

	column Test
		dataType: string
		summarizeBy: none
		isNameInferred
		sourceColumn: [Test]
		sortByColumn: Order

	column Order
		dataType: int64
		summarizeBy: none
		isNameInferred
		sourceColumn: [Order]

	partition 'Sim Lever Test' = calculated
		mode: import
		source =
				DATATABLE(
				    "Test", STRING, "Order", INTEGER,
				    {
				    { "+1 pp utilisation", 0 },
				    { "+1% rates", 1 },
				    { "+1 pp realisation", 2 },
				    { "+1% pay, everyone", 3 },
				    { "+5 pp disbursement recovery", 4 },
				    { "−1% overheads", 5 },
				    { "+1 Associate hire (50% productive)", 6 },
				    { "−1 support role", 7 }
				    }
				)
