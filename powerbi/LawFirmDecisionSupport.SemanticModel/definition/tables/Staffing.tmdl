table Staffing

	column branch_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: branch_key

	column department_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: department_key

	column headcount
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: headcount

	partition Staffing = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(BaseUrl, [RelativePath = "data/warehouse/fact_staffing.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"branch_key", "department_key", "headcount"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"branch_key", Int64.Type}, {"department_key", Int64.Type}, {"headcount", type number}}, "en-US")
				in
				    Typed
