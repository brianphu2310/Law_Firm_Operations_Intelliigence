table 'Country Geo'

	column Country
		dataType: string
		dataCategory: Country
		summarizeBy: none
		isNameInferred
		sourceColumn: [Country]

	column Latitude
		dataType: double
		dataCategory: Latitude
		summarizeBy: none
		isNameInferred
		sourceColumn: [Latitude]

	column Longitude
		dataType: double
		dataCategory: Longitude
		summarizeBy: none
		isNameInferred
		sourceColumn: [Longitude]

	partition 'Country Geo' = calculated
		mode: import
		source =
				DATATABLE(
