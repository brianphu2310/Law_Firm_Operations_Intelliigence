table RapidPay

	column date
		dataType: dateTime
		formatString: dd mmm yyyy
		summarizeBy: none
		sourceColumn: date

	column client
		dataType: string
		summarizeBy: none
		sourceColumn: client

	column amount
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: amount

	column fee
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: fee

	column method
		dataType: string
		summarizeBy: none
		sourceColumn: method

	partition RapidPay = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(BaseUrl, [RelativePath = "data/powerbi/rapidpay.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"date", "amount", "fee"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"date", type date}, {"client", type text}, {"amount", type number}, {"fee", type number}, {"method", type text}}, "en-US")
				in
				    Typed
