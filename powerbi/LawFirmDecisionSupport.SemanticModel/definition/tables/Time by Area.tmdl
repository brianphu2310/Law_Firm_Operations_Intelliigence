table 'Time by Area'

	column attorney_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: attorney_key

	column practice_area_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: practice_area_key

	column month_start_date_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: month_start_date_key

	column billable_hours
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: billable_hours

	column standard_value
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: standard_value

	column fees_realised
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: fees_realised

	column allocated_salary_cost
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: allocated_salary_cost

	partition 'Time by Area' = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(BaseUrl, [RelativePath = "data/warehouse/fact_time_by_area.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"attorney_key", "practice_area_key", "month_start_date_key", "billable_hours", "standard_value", "fees_realised", "allocated_salary_cost"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"attorney_key", Int64.Type}, {"practice_area_key", Int64.Type}, {"month_start_date_key", Int64.Type}, {"billable_hours", type number}, {"standard_value", type number}, {"fees_realised", type number}, {"allocated_salary_cost", type number}}, "en-US")
				in
				    Typed
