table 'Platform Gantt'

	column Platform
		dataType: string
		summarizeBy: none
		sourceColumn: Platform

	column Order
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Order

	column Phase
		dataType: string
		summarizeBy: none
		sourceColumn: Phase
		sortByColumn: Order

	column StartWeek
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: StartWeek

	column EndWeek
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: EndWeek

	column Weeks
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: Weeks

	partition 'Platform Gantt' = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(BaseUrl, [RelativePath = "data/powerbi/platform_gantt.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"Order", "StartWeek", "EndWeek", "Weeks"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"Platform", type text}, {"Order", Int64.Type}, {"Phase", type text}, {"StartWeek", type number}, {"EndWeek", type number}, {"Weeks", type number}}, "en-US")
				in
				    Typed
