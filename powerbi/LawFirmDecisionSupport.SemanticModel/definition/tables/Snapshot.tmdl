table Snapshot

	column month_start_date_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: month_start_date_key

	column snapshot_date_key
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: snapshot_date_key

	column wip_balance
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: wip_balance

	column cash_balance
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: cash_balance

	column receivables_incl_gst
		dataType: double
		formatString: #,0.0
		summarizeBy: none
		sourceColumn: receivables_incl_gst

	column trust_balance
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: trust_balance

	column matters_active
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: matters_active

	partition Snapshot = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(BaseUrl, [RelativePath = "data/warehouse/fact_monthly_snapshot.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"month_start_date_key", "snapshot_date_key", "wip_balance", "cash_balance", "receivables_incl_gst", "trust_balance", "matters_active"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"month_start_date_key", Int64.Type}, {"snapshot_date_key", Int64.Type}, {"wip_balance", type number}, {"cash_balance", type number}, {"receivables_incl_gst", type number}, {"trust_balance", type number}, {"matters_active", type number}}, "en-US")
				in
				    Typed
