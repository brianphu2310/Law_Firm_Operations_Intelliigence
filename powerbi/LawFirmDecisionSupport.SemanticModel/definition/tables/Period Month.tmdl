table 'Period Month'
	isHidden

	column Period
		dataType: string
		summarizeBy: none
		sourceColumn: Period

	column Role
		dataType: string
		summarizeBy: none
		sourceColumn: Role

	column MonthKey
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: MonthKey

	column Weight
		dataType: double
		formatString: 0.0%;-0.0%;0.0%
		summarizeBy: none
		sourceColumn: Weight

	partition 'Period Month' = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(BaseUrl, [RelativePath = "data/powerbi/period_month.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"MonthKey", "Weight"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"Period", type text}, {"Role", type text}, {"MonthKey", Int64.Type}, {"Weight", type number}}, "en-US")
				in
				    Typed
