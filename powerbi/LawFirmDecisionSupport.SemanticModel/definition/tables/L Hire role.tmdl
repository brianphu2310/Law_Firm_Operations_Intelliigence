table 'L Hire role'

	column 'Role of the hire'
		dataType: string
		summarizeBy: none
		isNameInferred
		sourceColumn: [Role of the hire]
		sortByColumn: Order

	column Order
		dataType: int64
		summarizeBy: none
		isNameInferred
		sourceColumn: [Order]

	partition 'L Hire role' = calculated
		mode: import
		source =
				DATATABLE(
				    "Role of the hire", STRING, "Order", INTEGER,
				    {
				    { "Associate", 1 },
				    { "Senior Associate", 2 },
				    { "Partner", 3 }
				    }
				)
