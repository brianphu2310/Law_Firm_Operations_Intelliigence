table Attorney

	column attorney_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: attorney_key

	column attorney_short
		dataType: string
		summarizeBy: none
		sourceColumn: attorney_short

	column attorney_name
		dataType: string
		summarizeBy: none
		sourceColumn: attorney_name

	column role
		dataType: string
		summarizeBy: none
		sourceColumn: role

	column home_branch_key
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: home_branch_key

	column start_date_key
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: start_date_key

	column target_hours_per_month
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: target_hours_per_month

	column bill_rate
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: bill_rate

	column pay_rate
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: pay_rate

	column realisation_factor
		dataType: double
		formatString: 0.0%;-0.0%;0.0%
		summarizeBy: none
		sourceColumn: realisation_factor

	partition Attorney = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(BaseUrl, [RelativePath = "data/warehouse/dim_attorney.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"attorney_key", "home_branch_key", "start_date_key", "target_hours_per_month", "bill_rate", "pay_rate", "realisation_factor"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"attorney_key", Int64.Type}, {"attorney_short", type text}, {"attorney_name", type text}, {"role", type text}, {"home_branch_key", Int64.Type}, {"start_date_key", Int64.Type}, {"target_hours_per_month", type number}, {"bill_rate", type number}, {"pay_rate", type number}, {"realisation_factor", type number}}, "en-US")
				in
				    Typed
