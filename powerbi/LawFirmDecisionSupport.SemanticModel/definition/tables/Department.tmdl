table Department

	column department_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: department_key

	column department
		dataType: string
		summarizeBy: none
		sourceColumn: department

	column monthly_pay
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: monthly_pay

	column workload_driver
		dataType: string
		summarizeBy: none
		sourceColumn: workload_driver

	column workload_per_fte
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: workload_per_fte

	column base_per_office
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: base_per_office

	column is_firm_wide
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: is_firm_wide

	partition Department = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(BaseUrl, [RelativePath = "data/warehouse/dim_department.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"department_key", "monthly_pay", "workload_per_fte", "base_per_office", "is_firm_wide"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"department_key", Int64.Type}, {"department", type text}, {"monthly_pay", type number}, {"workload_driver", type text}, {"workload_per_fte", type number}, {"base_per_office", type number}, {"is_firm_wide", type number}}, "en-US")
				in
				    Typed
