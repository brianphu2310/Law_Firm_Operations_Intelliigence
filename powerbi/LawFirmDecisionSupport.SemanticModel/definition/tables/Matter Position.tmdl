table 'Matter Position'

	column matter_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: matter_key

	column as_of_date_key
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: as_of_date_key

	column estimated_value
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: estimated_value

	column billed_to_date
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: billed_to_date

	column wip_balance
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: wip_balance

	column progress_ratio
		dataType: double
		formatString: 0.0%;-0.0%;0.0%
		summarizeBy: none
		sourceColumn: progress_ratio

	column days_open
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: days_open

	column 'Age bucket' = SWITCH( TRUE(), [days_open] <= 90, "0–90 days", [days_open] <= 180, "91–180 days", [days_open] <= 365, "181–365 days", "Over a year" )
		dataType: string
		summarizeBy: none

	partition 'Matter Position' = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(BaseUrl, [RelativePath = "data/warehouse/fact_matter_position.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"matter_key", "as_of_date_key", "estimated_value", "billed_to_date", "wip_balance", "progress_ratio", "days_open"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"matter_key", Int64.Type}, {"as_of_date_key", Int64.Type}, {"estimated_value", type number}, {"billed_to_date", type number}, {"wip_balance", type number}, {"progress_ratio", type number}, {"days_open", type number}}, "en-US")
				in
				    Typed
