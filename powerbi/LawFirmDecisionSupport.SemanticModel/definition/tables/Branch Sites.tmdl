table 'Branch Sites'

	column candidate_site
		dataType: string
		summarizeBy: none
		sourceColumn: candidate_site

	column underserved_matters_ltm
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: underserved_matters_ltm

	column est_value_ltm
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: est_value_ltm

	column suburbs_covered
		dataType: double
		formatString: #,0.0
		summarizeBy: none
		sourceColumn: suburbs_covered

	column nearest_office
		dataType: string
		summarizeBy: none
		sourceColumn: nearest_office

	column km_to_nearest_office
		dataType: double
		formatString: #,0.0
		summarizeBy: none
		sourceColumn: km_to_nearest_office

	column site_rank
		dataType: double
		formatString: #,0.0
		summarizeBy: none
		sourceColumn: site_rank

	partition 'Branch Sites' = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(BaseUrl, [RelativePath = "data/powerbi/branch_sites.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"underserved_matters_ltm", "est_value_ltm", "suburbs_covered", "km_to_nearest_office", "site_rank"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"candidate_site", type text}, {"underserved_matters_ltm", type number}, {"est_value_ltm", type number}, {"suburbs_covered", type number}, {"nearest_office", type text}, {"km_to_nearest_office", type number}, {"site_rank", type number}}, "en-US")
				in
				    Typed
