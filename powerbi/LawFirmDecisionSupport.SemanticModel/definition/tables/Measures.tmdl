			VAR e = [Period End Month]
			VAR m = MAX( 'Date'[month_start_date] )
			VAR v = SUM( 'Snapshot'[wip_balance] )
			VAR fr = 1
			RETURN IF( m > EDATE( e, -12 ) && m <= e && NOT ISBLANK( v ), DIVIDE( v, IF( ISBLANK( fr ), 1, fr ) ) )
