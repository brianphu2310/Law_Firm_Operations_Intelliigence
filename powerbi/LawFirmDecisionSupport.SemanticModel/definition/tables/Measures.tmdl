	measure 'P&L Actual' =
			SWITCH( SELECTEDVALUE( 'P&L Line'[Line] ),
			    "Fees", [Actual Fees],
			    "Disbursements billed", [Actual Disbursements billed],
			    "Total revenue", [Actual Total revenue],
			    "Fee-earner payroll", [Actual Fee-earner payroll],
			    "Disbursement costs", [Actual Disbursement costs],
			    "Support payroll", [Actual Support payroll],
			    "Rent", [Actual Rent],
			    "Software", [Actual Software],
			    "Insurance", [Actual Insurance],
			    "Marketing", [Actual Marketing],
			    "Professional fees", [Actual Professional fees],
			    "Card expenses", [Actual Card expenses],
			    "Merchant fees", [Actual Merchant fees],
			    "Referral commission", [Actual Referral commission],
			    "Bank fees", [Actual Bank fees],
			    "Other", [Actual Other],
			    "Total costs", [Actual Total costs],
			    "Operating profit", [Actual Operating profit]
			)
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: P&L

	measure 'P&L Budget' =
			SWITCH( SELECTEDVALUE( 'P&L Line'[Line] ),
			    "Fees", [Budget Fees],
			    "Disbursements billed", [Budget Disbursements billed],
			    "Total revenue", [Budget Total revenue],
			    "Fee-earner payroll", [Budget Fee-earner payroll],
			    "Disbursement costs", [Budget Disbursement costs],
			    "Support payroll", [Budget Support payroll],
			    "Rent", [Budget Rent],
			    "Software", [Budget Software],
			    "Insurance", [Budget Insurance],
			    "Marketing", [Budget Marketing],
			    "Professional fees", [Budget Professional fees],
			    "Card expenses", [Budget Card expenses],
			    "Merchant fees", [Budget Merchant fees],
			    "Referral commission", [Budget Referral commission],
			    "Bank fees", [Budget Bank fees],
			    "Other", [Budget Other],
			    "Total costs", [Budget Total costs],
			    "Operating profit", [Budget Operating profit]
			)
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: P&L

	/// Favourable is positive: more revenue or profit, or less cost, than budget.
	measure 'P&L Variance' =
			VAR a = [P&L Actual]
			VAR b = [P&L Budget]
			VAR cost = SELECTEDVALUE( 'P&L Line'[IsCost] )
			RETURN IF( cost = 1, b - a, a - b )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: P&L

	measure 'P&L Variance %' = DIVIDE( [P&L Variance], ABS( [P&L Budget] ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: P&L

	measure Revenue = [Actual Total revenue]
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: KPIs

	measure 'Revenue (prior)' =
			VAR p = [Period Sel]
			RETURN
			    SUMX(
			        FILTER( ALL( 'Period Month' ), 'Period Month'[Period] = p && 'Period Month'[Role] = "Prior" ),
			        'Period Month'[Weight] * CALCULATE( SUM( 'PnL'[revenue] ), 'PnL'[scenario_key] = 1, TREATAS( { 'Period Month'[MonthKey] }, 'Date'[date_key] ) )
			    )
		formatString: \$#,0;-\$#,0;\$0
		isHidden
		displayFolder: KPIs

	measure 'Operating Profit' = [Actual Operating profit]
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: KPIs

	measure 'Budget Operating Profit' = [Budget Operating profit]
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: KPIs

	measure 'Profit vs Budget' = [Operating Profit] - [Budget Operating Profit]
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: KPIs

	measure 'Operating Margin' = DIVIDE( [Operating Profit], [Revenue] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: KPIs

	measure Fees = [Actual Fees]
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: KPIs

	measure 'Billable Hours' =
			VAR p = [Period Sel]
			RETURN
			    SUMX(
			        FILTER( ALL( 'Period Month' ), 'Period Month'[Period] = p && 'Period Month'[Role] = "Current" ),
			        'Period Month'[Weight] * CALCULATE( SUM( 'PnL'[billable_hours] ), 'PnL'[scenario_key] = 1, TREATAS( { 'Period Month'[MonthKey] }, 'Date'[date_key] ) )
			    )
		formatString: #,0
		displayFolder: KPIs

	measure 'Billable Hours (prior)' =
			VAR p = [Period Sel]
			RETURN
			    SUMX(
			        FILTER( ALL( 'Period Month' ), 'Period Month'[Period] = p && 'Period Month'[Role] = "Prior" ),
			        'Period Month'[Weight] * CALCULATE( SUM( 'PnL'[billable_hours] ), 'PnL'[scenario_key] = 1, TREATAS( { 'Period Month'[MonthKey] }, 'Date'[date_key] ) )
			    )
		formatString: #,0
		isHidden
		displayFolder: KPIs

	measure 'Capacity Hours' =
			VAR p = [Period Sel]
			RETURN
			    SUMX(
			        FILTER( ALL( 'Period Month' ), 'Period Month'[Period] = p && 'Period Month'[Role] = "Current" ),
			        'Period Month'[Weight] * CALCULATE( SUM( 'PnL'[capacity_hours] ), 'PnL'[scenario_key] = 1, TREATAS( { 'Period Month'[MonthKey] }, 'Date'[date_key] ) )
			    )
		formatString: #,0
		displayFolder: KPIs

	measure 'Capacity Hours (prior)' =
			VAR p = [Period Sel]
			RETURN
			    SUMX(
			        FILTER( ALL( 'Period Month' ), 'Period Month'[Period] = p && 'Period Month'[Role] = "Prior" ),
			        'Period Month'[Weight] * CALCULATE( SUM( 'PnL'[capacity_hours] ), 'PnL'[scenario_key] = 1, TREATAS( { 'Period Month'[MonthKey] }, 'Date'[date_key] ) )
			    )
		formatString: #,0
		isHidden
		displayFolder: KPIs

	measure 'Standard Value' =
			VAR p = [Period Sel]
			RETURN
			    SUMX(
			        FILTER( ALL( 'Period Month' ), 'Period Month'[Period] = p && 'Period Month'[Role] = "Current" ),
			        'Period Month'[Weight] * CALCULATE( SUM( 'PnL'[standard_value] ), 'PnL'[scenario_key] = 1, TREATAS( { 'Period Month'[MonthKey] }, 'Date'[date_key] ) )
			    )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: KPIs

	measure Utilisation = DIVIDE( [Billable Hours], [Capacity Hours] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: KPIs

	measure 'Utilisation (prior)' = DIVIDE( [Billable Hours (prior)], [Capacity Hours (prior)] )
		formatString: 0.0%;-0.0%;0.0%
		isHidden
		displayFolder: KPIs

	measure Realisation = DIVIDE( [Fees], [Standard Value] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: KPIs

	measure 'Effective Rate' = DIVIDE( [Fees], [Billable Hours] )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: KPIs

	measure 'Disbursement Recovery' = DIVIDE( [Actual Disbursements billed], [Actual Disbursement costs] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: KPIs

	measure 'Collections ex GST' =
			VAR p = [Period Sel]
			RETURN
			    SUMX(
			        FILTER( ALL( 'Period Month' ), 'Period Month'[Period] = p && 'Period Month'[Role] = "Current" ),
			        'Period Month'[Weight] * CALCULATE( SUM( 'Monthly Extra'[CollectionsExGST] ), TREATAS( { 'Period Month'[MonthKey] }, 'Date'[date_key] ) )
			    )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: KPIs

	measure 'Collections ex GST (prior)' =
			VAR p = [Period Sel]
			RETURN
			    SUMX(
			        FILTER( ALL( 'Period Month' ), 'Period Month'[Period] = p && 'Period Month'[Role] = "Prior" ),
			        'Period Month'[Weight] * CALCULATE( SUM( 'Monthly Extra'[CollectionsExGST] ), TREATAS( { 'Period Month'[MonthKey] }, 'Date'[date_key] ) )
			    )
		formatString: \$#,0;-\$#,0;\$0
		isHidden
		displayFolder: KPIs

	measure 'Matters Opened' =
			VAR p = [Period Sel]
			RETURN
			    SUMX(
			        FILTER( ALL( 'Period Month' ), 'Period Month'[Period] = p && 'Period Month'[Role] = "Current" ),
			        'Period Month'[Weight] * CALCULATE( SUM( 'Monthly Extra'[MattersOpened] ), TREATAS( { 'Period Month'[MonthKey] }, 'Date'[date_key] ) )
			    )
		formatString: #,0
		displayFolder: KPIs

	measure 'Active Matters' =
			VAR p = [Period Sel]
			RETURN CALCULATE( MAX( 'Period Balance'[ActiveMatters] ), REMOVEFILTERS( 'Period Balance' ), 'Period Balance'[Period] = p, 'Period Balance'[Role] = "Current" )
		formatString: #,0
		displayFolder: Balances

	measure 'Active Matters (prior)' =
			VAR p = [Period Sel]
			RETURN CALCULATE( MAX( 'Period Balance'[ActiveMatters] ), REMOVEFILTERS( 'Period Balance' ), 'Period Balance'[Period] = p, 'Period Balance'[Role] = "Prior" )
		formatString: #,0
		isHidden
		displayFolder: Balances

	measure 'Office Cash' =
			VAR p = [Period Sel]
			RETURN CALCULATE( MAX( 'Period Balance'[Cash] ), REMOVEFILTERS( 'Period Balance' ), 'Period Balance'[Period] = p, 'Period Balance'[Role] = "Current" )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Balances

	measure WIP =
			VAR p = [Period Sel]
			RETURN CALCULATE( MAX( 'Period Balance'[WIP] ), REMOVEFILTERS( 'Period Balance' ), 'Period Balance'[Period] = p, 'Period Balance'[Role] = "Current" )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Balances

	measure Receivables =
			VAR p = [Period Sel]
			RETURN CALCULATE( MAX( 'Period Balance'[Receivables] ), REMOVEFILTERS( 'Period Balance' ), 'Period Balance'[Period] = p, 'Period Balance'[Role] = "Current" )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Balances

	measure 'Trust Funds' =
			VAR p = [Period Sel]
			RETURN CALCULATE( MAX( 'Period Balance'[Trust] ), REMOVEFILTERS( 'Period Balance' ), 'Period Balance'[Period] = p, 'Period Balance'[Role] = "Current" )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Balances

	/// Days sales outstanding: receivables over the last 90 days of billing.
	measure DSO =
			VAR p = [Period Sel]
			RETURN CALCULATE( MAX( 'Period Balance'[DSO] ), REMOVEFILTERS( 'Period Balance' ), 'Period Balance'[Period] = p, 'Period Balance'[Role] = "Current" )
		formatString: #,0.0
		displayFolder: Balances

	/// WIP plus receivables, in days of billing.
	measure 'Lockup Days' =
			VAR p = [Period Sel]
			RETURN CALCULATE( MAX( 'Period Balance'[Lockup] ), REMOVEFILTERS( 'Period Balance' ), 'Period Balance'[Period] = p, 'Period Balance'[Role] = "Current" )
		formatString: #,0.0
		displayFolder: Balances

	measure 'Funds Employed' = [WIP] + [Receivables] + [Trust Funds]
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Balances

	measure 'Deadlines Next 30 Days' = COUNTROWS( FILTER( 'Deadlines', 'Deadlines'[days_from_as_of] >= 0 && 'Deadlines'[days_from_as_of] <= 30 ) ) + 0
		formatString: #,0
		displayFolder: KPIs

	measure 'Deadlines Following 30 Days' = COUNTROWS( FILTER( 'Deadlines', 'Deadlines'[days_from_as_of] > 30 && 'Deadlines'[days_from_as_of] <= 60 ) ) + 0
		formatString: #,0
		displayFolder: KPIs

	measure 'Deadlines Caption' = FORMAT( [Deadlines Following 30 Days], "0" ) & " more in the following 30 days"
		displayFolder: KPIs

	measure 'Hours Δ' =
			VAR c = [Billable Hours]
			VAR pr = [Billable Hours (prior)]
			VAR d = DIVIDE( [Billable Hours] - [Billable Hours (prior)], ABS( [Billable Hours (prior)] ) )
			RETURN IF( ISBLANK( pr ) || pr = 0, "no comparison", FORMAT( d, "▲ +0.0%;▼ -0.0%;0.0%" ) & " vs prior period" )
		displayFolder: KPIs\Change

	measure 'Collections Δ' =
			VAR c = [Collections ex GST]
			VAR pr = [Collections ex GST (prior)]
			VAR d = DIVIDE( [Collections ex GST] - [Collections ex GST (prior)], ABS( [Collections ex GST (prior)] ) )
			RETURN IF( ISBLANK( pr ) || pr = 0, "no comparison", FORMAT( d, "▲ +0.0%;▼ -0.0%;0.0%" ) & " vs prior period" )
		displayFolder: KPIs\Change

	measure 'Utilisation Δ' =
			VAR c = [Utilisation]
			VAR pr = [Utilisation (prior)]
			VAR d = [Utilisation] - [Utilisation (prior)]
			RETURN IF( ISBLANK( pr ) || pr = 0, "no comparison", FORMAT( d * 100, "▲ +0.0 ""pp"";▼ -0.0 ""pp"";0.0 ""pp""" ) & " vs prior period" )
		displayFolder: KPIs\Change

	measure 'Active Matters Δ' =
			VAR c = [Active Matters]
			VAR pr = [Active Matters (prior)]
			VAR d = DIVIDE( [Active Matters] - [Active Matters (prior)], ABS( [Active Matters (prior)] ) )
			RETURN IF( ISBLANK( pr ) || pr = 0, "no comparison", FORMAT( d, "▲ +0.0%;▼ -0.0%;0.0%" ) & " vs prior period" )
		displayFolder: KPIs\Change

	measure 'Revenue Δ' =
			VAR c = [Revenue]
			VAR pr = [Revenue (prior)]
			VAR d = DIVIDE( [Revenue] - [Revenue (prior)], ABS( [Revenue (prior)] ) )
			RETURN IF( ISBLANK( pr ) || pr = 0, "no comparison", FORMAT( d, "▲ +0.0%;▼ -0.0%;0.0%" ) & " vs prior period" )
		displayFolder: KPIs\Change

	measure 'Attorney Hours' =
			VAR p = [Period Sel]
			RETURN
			    SUMX(
			        FILTER( ALL( 'Period Month' ), 'Period Month'[Period] = p && 'Period Month'[Role] = "Current" ),
			        'Period Month'[Weight] * CALCULATE( SUM( 'Attorney Month'[billable_hours] ), TREATAS( { 'Period Month'[MonthKey] }, 'Date'[date_key] ) )
			    )
		formatString: #,0
		displayFolder: People

	measure 'Attorney Capacity' =
			VAR p = [Period Sel]
			RETURN
			    SUMX(
			        FILTER( ALL( 'Period Month' ), 'Period Month'[Period] = p && 'Period Month'[Role] = "Current" ),
			        'Period Month'[Weight] * CALCULATE( SUM( 'Attorney Month'[capacity_hours] ), TREATAS( { 'Period Month'[MonthKey] }, 'Date'[date_key] ) )
			    )
		formatString: #,0
		displayFolder: People

	measure 'Attorney Fees' =
			VAR p = [Period Sel]
			RETURN
			    SUMX(
			        FILTER( ALL( 'Period Month' ), 'Period Month'[Period] = p && 'Period Month'[Role] = "Current" ),
			        'Period Month'[Weight] * CALCULATE( SUM( 'Attorney Month'[fees_realised] ), TREATAS( { 'Period Month'[MonthKey] }, 'Date'[date_key] ) )
			    )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: People

	measure 'Attorney Fees (prior)' =
			VAR p = [Period Sel]
			RETURN
			    SUMX(
			        FILTER( ALL( 'Period Month' ), 'Period Month'[Period] = p && 'Period Month'[Role] = "Prior" ),
			        'Period Month'[Weight] * CALCULATE( SUM( 'Attorney Month'[fees_realised] ), TREATAS( { 'Period Month'[MonthKey] }, 'Date'[date_key] ) )
			    )
		formatString: \$#,0;-\$#,0;\$0
		isHidden
		displayFolder: People

	measure 'Attorney Standard Value' =
			VAR p = [Period Sel]
			RETURN
			    SUMX(
			        FILTER( ALL( 'Period Month' ), 'Period Month'[Period] = p && 'Period Month'[Role] = "Current" ),
			        'Period Month'[Weight] * CALCULATE( SUM( 'Attorney Month'[standard_value] ), TREATAS( { 'Period Month'[MonthKey] }, 'Date'[date_key] ) )
			    )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: People

	measure 'Attorney Cost' =
			VAR p = [Period Sel]
			RETURN
			    SUMX(
			        FILTER( ALL( 'Period Month' ), 'Period Month'[Period] = p && 'Period Month'[Role] = "Current" ),
			        'Period Month'[Weight] * CALCULATE( SUM( 'Attorney Month'[salary_cost] ), TREATAS( { 'Period Month'[MonthKey] }, 'Date'[date_key] ) )
			    )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: People

	measure 'Attorney Utilisation' = DIVIDE( [Attorney Hours], [Attorney Capacity] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: People

	measure 'Attorney Realisation' = DIVIDE( [Attorney Fees], [Attorney Standard Value] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: People

	measure 'Attorney Effective Rate' = DIVIDE( [Attorney Fees], [Attorney Hours] )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: People

	measure 'Attorney Contribution' = [Attorney Fees] - [Attorney Cost]
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: People

	measure 'Attorney Break-even Hours' = DIVIDE( [Attorney Cost], [Attorney Effective Rate] )
		formatString: #,0
		displayFolder: People

	measure 'Top Biller' =
			VAR t = TOPN( 1, ALL( 'Attorney'[attorney_short] ), [Attorney Fees], DESC )
			RETURN "Top biller · " & MAXX( t, 'Attorney'[attorney_short] )
		displayFolder: People

	measure 'Top Biller Fees' = MAXX( ALL( 'Attorney'[attorney_short] ), [Attorney Fees] )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: People

	measure 'Top Biller Δ' =
			VAR t = TOPN( 1, ALL( 'Attorney'[attorney_short] ), [Attorney Fees], DESC )
			VAR n = MAXX( t, 'Attorney'[attorney_short] )
			VAR c = CALCULATE( [Attorney Fees], 'Attorney'[attorney_short] = n )
			VAR pr = CALCULATE( [Attorney Fees (prior)], 'Attorney'[attorney_short] = n )
			VAR d = DIVIDE( c - pr, ABS( pr ) )
			RETURN IF( ISBLANK( pr ) || pr = 0, "no comparison", FORMAT( d, "▲ +0.0%;▼ -0.0%;0.0%" ) & " vs prior period" )
		displayFolder: People

	measure 'Area Hours' =
			VAR p = [Period Sel]
			RETURN
			    SUMX(
			        FILTER( ALL( 'Period Month' ), 'Period Month'[Period] = p && 'Period Month'[Role] = "Current" ),
			        'Period Month'[Weight] * CALCULATE( SUM( 'Time by Area'[billable_hours] ), TREATAS( { 'Period Month'[MonthKey] }, 'Date'[date_key] ) )
			    )
		formatString: #,0
		displayFolder: People

	measure 'Area Fees' =
			VAR p = [Period Sel]
			RETURN
			    SUMX(
			        FILTER( ALL( 'Period Month' ), 'Period Month'[Period] = p && 'Period Month'[Role] = "Current" ),
			        'Period Month'[Weight] * CALCULATE( SUM( 'Time by Area'[fees_realised] ), TREATAS( { 'Period Month'[MonthKey] }, 'Date'[date_key] ) )
			    )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: People

	measure 'Trend Billable Hours' =
			VAR e = [Period End Month]
			VAR m = MAX( 'Date'[month_start_date] )
			VAR v = CALCULATE( SUM( 'PnL'[billable_hours] ), 'PnL'[scenario_key] = 1 )
			VAR fr = CALCULATE( MAX( 'Monthly Extra'[Fraction] ) )
			RETURN IF( m > EDATE( e, -12 ) && m <= e && NOT ISBLANK( v ), DIVIDE( v, IF( ISBLANK( fr ), 1, fr ) ) )
		formatString: #,0
		displayFolder: Trends

	measure 'Trend Revenue' =
			VAR e = [Period End Month]
			VAR m = MAX( 'Date'[month_start_date] )
			VAR v = CALCULATE( SUM( 'PnL'[revenue] ), 'PnL'[scenario_key] = 1 )
			VAR fr = CALCULATE( MAX( 'Monthly Extra'[Fraction] ) )
			RETURN IF( m > EDATE( e, -12 ) && m <= e && NOT ISBLANK( v ), DIVIDE( v, IF( ISBLANK( fr ), 1, fr ) ) )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Trends

	measure 'Trend Budget Revenue' =
			VAR e = [Period End Month]
			VAR m = MAX( 'Date'[month_start_date] )
			VAR v = CALCULATE( SUM( 'PnL'[revenue] ), 'PnL'[scenario_key] = 2 )
			VAR fr = CALCULATE( MAX( 'Monthly Extra'[Fraction] ) )
			RETURN IF( m > EDATE( e, -12 ) && m <= e && NOT ISBLANK( v ), DIVIDE( v, IF( ISBLANK( fr ), 1, fr ) ) )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Trends

	measure 'Trend Operating Profit' =
			VAR e = [Period End Month]
			VAR m = MAX( 'Date'[month_start_date] )
			VAR v = CALCULATE( SUM( 'PnL'[operating_profit] ), 'PnL'[scenario_key] = 1 )
			VAR fr = CALCULATE( MAX( 'Monthly Extra'[Fraction] ) )
			RETURN IF( m > EDATE( e, -12 ) && m <= e && NOT ISBLANK( v ), DIVIDE( v, IF( ISBLANK( fr ), 1, fr ) ) )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Trends

	measure 'Trend Budget Operating Profit' =
			VAR e = [Period End Month]
			VAR m = MAX( 'Date'[month_start_date] )
			VAR v = CALCULATE( SUM( 'PnL'[operating_profit] ), 'PnL'[scenario_key] = 2 )
			VAR fr = CALCULATE( MAX( 'Monthly Extra'[Fraction] ) )
			RETURN IF( m > EDATE( e, -12 ) && m <= e && NOT ISBLANK( v ), DIVIDE( v, IF( ISBLANK( fr ), 1, fr ) ) )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Trends

	measure 'Trend Utilisation' =
			VAR e = [Period End Month]
			VAR m = MAX( 'Date'[month_start_date] )
			VAR v = DIVIDE( CALCULATE( SUM( 'PnL'[billable_hours] ), 'PnL'[scenario_key] = 1 ), CALCULATE( SUM( 'PnL'[capacity_hours] ), 'PnL'[scenario_key] = 1 ) )
			VAR fr = 1
			RETURN IF( m > EDATE( e, -12 ) && m <= e && NOT ISBLANK( v ), DIVIDE( v, IF( ISBLANK( fr ), 1, fr ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Trends

	measure 'Trend Area Hours' =
			VAR e = [Period End Month]
			VAR m = MAX( 'Date'[month_start_date] )
			VAR v = SUM( 'Time by Area'[billable_hours] )
			VAR fr = CALCULATE( MAX( 'Monthly Extra'[Fraction] ) )
			RETURN IF( m > EDATE( e, -12 ) && m <= e && NOT ISBLANK( v ), DIVIDE( v, IF( ISBLANK( fr ), 1, fr ) ) )
		formatString: #,0
		displayFolder: Trends

	measure 'Trend Attorney Hours' =
			VAR e = [Period End Month]
			VAR m = MAX( 'Date'[month_start_date] )
			VAR v = SUM( 'Attorney Month'[billable_hours] )
			VAR fr = CALCULATE( MAX( 'Monthly Extra'[Fraction] ) )
			RETURN IF( m > EDATE( e, -12 ) && m <= e && NOT ISBLANK( v ), DIVIDE( v, IF( ISBLANK( fr ), 1, fr ) ) )
		formatString: #,0
		displayFolder: Trends

	measure 'Trend Attorney Utilisation' =
			VAR e = [Period End Month]
			VAR m = MAX( 'Date'[month_start_date] )
			VAR v = DIVIDE( SUM( 'Attorney Month'[billable_hours] ), SUM( 'Attorney Month'[capacity_hours] ) )
