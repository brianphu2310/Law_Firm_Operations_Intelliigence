table Measures

	/// The reporting period picked on the Period slicer (FY26 Q1 QTD when none).
	measure 'Period Sel' = SELECTEDVALUE( 'Period'[Period], "FY26 Q1 QTD" )
		displayFolder: Period

	measure 'Period End' =
			VAR p = [Period Sel]
			RETURN CALCULATE( MAX( 'Period'[End] ), REMOVEFILTERS( 'Period' ), 'Period'[Period] = p )
		formatString: dd mmm yyyy
		displayFolder: Period

	measure 'Period End Month' =
			VAR p = [Period Sel]
			VAR k = CALCULATE( MAX( 'Period'[MonthEndKey] ), REMOVEFILTERS( 'Period' ), 'Period'[Period] = p )
			RETURN DATE( INT( k / 10000 ), MOD( INT( k / 100 ), 100 ), 1 )
		formatString: dd mmm yyyy
		isHidden
		displayFolder: Period

	measure 'Period Caption' =
			VAR p = [Period Sel]
			VAR s = CALCULATE( MAX( 'Period'[Start] ), REMOVEFILTERS( 'Period' ), 'Period'[Period] = p )
			VAR e = [Period End]
			RETURN p & " · " & FORMAT( s, "d mmm yy" ) & " – " & FORMAT( e, "d mmm yy" ) & " · vs prior period · data as of 17 Sep 2025"
		displayFolder: Period

	measure 'Actual Fees' =
			VAR p = [Period Sel]
			RETURN
			    SUMX(
			        FILTER( ALL( 'Period Month' ), 'Period Month'[Period] = p && 'Period Month'[Role] = "Current" ),
			        'Period Month'[Weight] * CALCULATE( SUM( 'PnL'[fees] ), 'PnL'[scenario_key] = 1, TREATAS( { 'Period Month'[MonthKey] }, 'Date'[date_key] ) )
			    )
		formatString: \$#,0;-\$#,0;\$0
		isHidden
		displayFolder: P&L\Actual

	measure 'Budget Fees' =
			VAR p = [Period Sel]
			RETURN
			    SUMX(
			        FILTER( ALL( 'Period Month' ), 'Period Month'[Period] = p && 'Period Month'[Role] = "Current" ),
			        'Period Month'[Weight] * CALCULATE( SUM( 'PnL'[fees] ), 'PnL'[scenario_key] = 2, TREATAS( { 'Period Month'[MonthKey] }, 'Date'[date_key] ) )
			    )
		formatString: \$#,0;-\$#,0;\$0
		isHidden
		displayFolder: P&L\Budget

	measure 'Actual Disbursements billed' =
			VAR p = [Period Sel]
