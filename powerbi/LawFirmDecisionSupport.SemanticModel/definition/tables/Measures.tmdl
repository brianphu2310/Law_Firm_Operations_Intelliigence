		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Trends

	measure 'Trend Trust' =
			VAR e = [Period End Month]
			VAR m = MAX( 'Date'[month_start_date] )
			VAR v = SUM( 'Trust Balance'[closing_balance] )
			VAR fr = 1
			RETURN IF( m > EDATE( e, -12 ) && m <= e && NOT ISBLANK( v ), DIVIDE( v, IF( ISBLANK( fr ), 1, fr ) ) )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Trends

	measure 'Trend Realisation' =
			VAR e = [Period End Month]
			VAR m = MAX( 'Date'[month_start_date] )
			VAR v = DIVIDE( CALCULATE( SUM( 'PnL'[fees] ), 'PnL'[scenario_key] = 1 ), CALCULATE( SUM( 'PnL'[standard_value] ), 'PnL'[scenario_key] = 1 ) )
			VAR fr = 1
			RETURN IF( m > EDATE( e, -12 ) && m <= e && NOT ISBLANK( v ), DIVIDE( v, IF( ISBLANK( fr ), 1, fr ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Trends

	measure 'Funnel Inquiries' =
			VAR p = [Period Sel]
			RETURN
			    SUMX(
			        FILTER( ALL( 'Period Month' ), 'Period Month'[Period] = p && 'Period Month'[Role] = "Current" ),
			        'Period Month'[Weight] * CALCULATE( SUM( 'Funnel'[inquiries] ), TREATAS( { 'Period Month'[MonthKey] }, 'Date'[date_key] ) )
			    )
		formatString: #,0
		isHidden
		displayFolder: Funnel

	measure 'Funnel Consultations booked' =
			VAR p = [Period Sel]
			RETURN
			    SUMX(
			        FILTER( ALL( 'Period Month' ), 'Period Month'[Period] = p && 'Period Month'[Role] = "Current" ),
			        'Period Month'[Weight] * CALCULATE( SUM( 'Funnel'[consultations_booked] ), TREATAS( { 'Period Month'[MonthKey] }, 'Date'[date_key] ) )
			    )
		formatString: #,0
		isHidden
		displayFolder: Funnel

	measure 'Funnel Consultations held' =
			VAR p = [Period Sel]
			RETURN
			    SUMX(
			        FILTER( ALL( 'Period Month' ), 'Period Month'[Period] = p && 'Period Month'[Role] = "Current" ),
			        'Period Month'[Weight] * CALCULATE( SUM( 'Funnel'[consultations_held] ), TREATAS( { 'Period Month'[MonthKey] }, 'Date'[date_key] ) )
			    )
		formatString: #,0
		isHidden
		displayFolder: Funnel

	measure 'Funnel Engagement letters sent' =
			VAR p = [Period Sel]
			RETURN
			    SUMX(
			        FILTER( ALL( 'Period Month' ), 'Period Month'[Period] = p && 'Period Month'[Role] = "Current" ),
			        'Period Month'[Weight] * CALCULATE( SUM( 'Funnel'[letters_sent] ), TREATAS( { 'Period Month'[MonthKey] }, 'Date'[date_key] ) )
			    )
		formatString: #,0
		isHidden
		displayFolder: Funnel

	measure 'Funnel New matters opened' =
			VAR p = [Period Sel]
			RETURN
			    SUMX(
			        FILTER( ALL( 'Period Month' ), 'Period Month'[Period] = p && 'Period Month'[Role] = "Current" ),
			        'Period Month'[Weight] * CALCULATE( SUM( 'Funnel'[matters_opened] ), TREATAS( { 'Period Month'[MonthKey] }, 'Date'[date_key] ) )
			    )
		formatString: #,0
		isHidden
		displayFolder: Funnel

	measure 'Funnel Value' =
			SWITCH( SELECTEDVALUE( 'Funnel Stage'[Stage] ),
			    "Inquiries", [Funnel Inquiries],
			    "Consultations booked", [Funnel Consultations booked],
			    "Consultations held", [Funnel Consultations held],
			    "Engagement letters sent", [Funnel Engagement letters sent],
			    "New matters opened", [Funnel New matters opened]
			)
		formatString: #,0
		displayFolder: Funnel

	measure 'Funnel Conversion' = DIVIDE( [Funnel New matters opened], [Funnel Inquiries] )
		formatString: 0%;-0%;0%
		displayFolder: Funnel

	measure 'Funnel Step Conversion' =
			VAR o = SELECTEDVALUE( 'Funnel Stage'[Order] )
			VAR prev = CALCULATE( [Funnel Value], REMOVEFILTERS( 'Funnel Stage' ), 'Funnel Stage'[Order] = o - 1 )
			RETURN IF( o = 1, 1, DIVIDE( [Funnel Value], prev ) )
		formatString: 0%;-0%;0%
		displayFolder: Funnel

	measure 'AR Amount' = SUM( 'AR Ageing'[Amount] )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Finance

	measure 'Client Revenue' = SUM( 'Client Period'[revenue] )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Clients

	measure 'Client Receivables' = SUM( 'Client Period'[ar] )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Clients

	measure 'Client Overdue' = SUM( 'Client Period'[overdue] )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Clients

	measure 'Top 5 Client Share' =
			VAR t = TOPN( 5, 'Client Period', 'Client Period'[revenue], DESC )
			RETURN DIVIDE( SUMX( t, 'Client Period'[revenue] ), SUM( 'Client Period'[revenue] ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Clients

	measure 'Supplier Spend' = SUM( 'Supplier Order'[amount] )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Finance

	measure 'Card Spend' = SUM( 'Cards'[amount] )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Finance

	measure 'Trust Txn Amount' = SUM( 'Trust Txn'[amount] )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Finance

	measure 'Cash Inflow' = SUM( 'Cash Forecast'[in_open] ) + SUM( 'Cash Forecast'[in_new] )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Finance

	measure 'Cash Outflow' = SUM( 'Cash Forecast'[out_payroll] ) + SUM( 'Cash Forecast'[out_rent] ) + SUM( 'Cash Forecast'[out_opex] ) + SUM( 'Cash Forecast'[out_disb] ) + SUM( 'Cash Forecast'[out_bas] ) + SUM( 'Cash Forecast'[out_drawings] )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Finance

	measure 'Cash Closing' = SUM( 'Cash Forecast'[closing] )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Finance

	measure 'Cash Minimum' = MAX( 'Cash Forecast'[min_cash] )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Finance

	measure 'Cash Low Point' = MINX( ALL( 'Cash Forecast' ), 'Cash Forecast'[closing] )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Finance

	measure 'FY Forecast Profit' = MAX( 'FY Summary'[fc_op] )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Finance

	measure 'FY Budget Profit' = MAX( 'FY Summary'[budget_op] )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Finance

	measure 'FY Forecast Revenue' = MAX( 'FY Summary'[fc_rev] )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Finance

	measure 'FY Budget Revenue' = MAX( 'FY Summary'[budget_rev] )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Finance

	measure 'FY Profit Gap' = [FY Forecast Profit] - [FY Budget Profit]
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Finance

	measure 'FY Path Revenue' = SUM( 'FY Outlook'[revenue] )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Finance

	measure 'FY Path Budget Revenue' = SUM( 'FY Outlook'[budget_rev] )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Finance

	measure 'FY Path Profit' = SUM( 'FY Outlook'[op_profit] )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Finance

	measure 'FY Path Budget Profit' = SUM( 'FY Outlook'[budget_op] )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Finance

	measure 'FY Path Actual Profit' = CALCULATE( SUM( 'FY Outlook'[op_profit] ), 'FY Outlook'[kind] = "Actual" )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Finance

	measure 'FY Path Forecast Profit' = CALCULATE( SUM( 'FY Outlook'[op_profit] ), 'FY Outlook'[kind] = "Forecast" )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Finance

	measure Headcount = SUM( 'Staffing'[headcount] )
		formatString: #,0
		displayFolder: People

	measure 'Support Needed' = SUM( 'Dept Workload'[needed] )
		formatString: #,0.0
		displayFolder: People

	measure 'Support Headcount' = SUM( 'Dept Workload'[headcount] )
		formatString: #,0
		displayFolder: People

	measure 'Support Gap Cost' = SUM( 'Dept Workload'[cost_of_gap] )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: People

	measure 'Over-staffed Cost' = CALCULATE( SUM( 'Dept Workload'[cost_of_gap] ), 'Dept Workload'[status] = "Over-staffed" )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: People

	measure 'Hire Priority' = SUM( 'Where to Hire'[priority] )
		formatString: #,0.0
		displayFolder: People

	measure 'Area Utilisation' = SUM( 'Where to Hire'[util] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: People

	measure 'Area New Matter Growth' = SUM( 'Where to Hire'[matters_growth] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: People

	measure 'Area Contribution' = SUM( 'Where to Hire'[contribution] )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: People

	measure 'Hire First' = "Hire next in " & MAXX( FILTER( ALL( 'Where to Hire' ), 'Where to Hire'[rank] = 1 ), 'Where to Hire'[area] )
		displayFolder: People

	/// ABS Wage Price Index, private sector, year to the September quarter 2026.
	measure 'Market Wage Growth' = 0.034
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: People

	measure 'Marketing Spend' = SUM( 'Marketing'[spend] )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Marketing

	measure 'Marketing Matters' = SUM( 'Marketing'[matters] )
		formatString: #,0.0
		displayFolder: Marketing

	measure 'Marketing Fees' = SUM( 'Marketing'[fees] )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Marketing

	measure 'Cost per Matter' = DIVIDE( [Marketing Spend], [Marketing Matters] )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Marketing

	measure 'Fees per Dollar' = DIVIDE( [Marketing Fees], [Marketing Spend] )
		formatString: 0.0x
		displayFolder: Marketing

	measure 'Cheapest Channel' =
			VAR t = TOPN( 1, VALUES( 'Marketing'[channel] ), [Cost per Matter], ASC )
			RETURN MAXX( t, 'Marketing'[channel] )
		displayFolder: Marketing

	measure 'Matter Count' = COUNTROWS( 'Matter' )
		formatString: #,0
		displayFolder: Matters

	measure 'Open Matters' = CALCULATE( COUNTROWS( 'Matter' ), 'Matter'[status] <> "Closed" )
		formatString: #,0
		displayFolder: Matters

	measure 'Matter WIP' = SUM( 'Matter Position'[wip_balance] )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Matters

	measure 'Matter Billed' = SUM( 'Matter Position'[billed_to_date] )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Matters

	measure 'Matter Estimated Value' = SUM( 'Matter Position'[estimated_value] )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Matters

	measure 'Deadline Count' = COUNTROWS( 'Deadlines' ) + 0
		formatString: #,0
		displayFolder: Calendar

	measure 'Platform NPV' = SUM( 'Platforms'[NPV] )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Platform

	measure 'Platform Run Rate' = SUM( 'Platforms'[RunRate] )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Platform

	measure 'Platform Score' = AVERAGE( 'Platforms'[Score] )
		formatString: #,0.0
		displayFolder: Platform

	measure 'Platform Cumulative' = SUM( 'Platform Cashflow'[Cumulative] )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Platform

	measure 'Platform Weighted Score' = DIVIDE( SUMX( 'Platform Scores', 'Platform Scores'[Score] * 'Platform Scores'[Weight] ), SUM( 'Platform Scores'[Weight] ) )
		formatString: #,0.0
		displayFolder: Platform

	measure 'Platform Criterion Score' = SUM( 'Platform Scores'[Score] )
		formatString: 0
		displayFolder: Platform

	measure 'Platform Verdict' = SELECTEDVALUE( 'Platforms'[Verdict] )
		displayFolder: Platform

	measure 'Platform Grid NPV' = SUM( 'Platform NPV Grid'[NPV] )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Platform

	measure 'Best Platform' =
			VAR t = TOPN( 1, ALL( 'Platforms'[Platform] ), CALCULATE( MAX( 'Platforms'[Decision] ) ), DESC )
			RETURN MAXX( t, 'Platforms'[Platform] )
		displayFolder: Platform

	measure Story = "HOW THIS STARTED  The Principal asked which software saves the firm the most (" & FORMAT( CALCULATE( MAX( 'Platforms'[RunRate] ), 'Platforms'[IsCurrent] = 1 ), "$#,0" ) & " a year on LEAP + InfoTrack today; best: " & [Best Platform] & ", NPV " & FORMAT( CALCULATE( MAX( 'Platforms'[NPV] ), 'Platforms'[Platform] = [Best Platform] ), "+$#,0" ) & "). The same model now answers hiring, staffing, pay, marketing, new services and branches."
		displayFolder: Overview

	column Note
		dataType: string
		isHidden
		summarizeBy: none
		isNameInferred
		sourceColumn: [Note]

	partition Measures = calculated
		mode: import
		source =
				ROW( "Note", "Measures live here" )
