table Funnel

	column month_start_date_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: month_start_date_key

	column month_fraction_elapsed
		dataType: double
		formatString: 0.0%;-0.0%;0.0%
		summarizeBy: none
		sourceColumn: month_fraction_elapsed

	column inquiries
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: inquiries

	column consultations_booked
		dataType: double
		formatString: #,0.0
		summarizeBy: none
		sourceColumn: consultations_booked

	column consultations_held
		dataType: double
		formatString: #,0.0
		summarizeBy: none
		sourceColumn: consultations_held

	column letters_sent
		dataType: double
		formatString: #,0.0
		summarizeBy: none
		sourceColumn: letters_sent

	column matters_opened
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: matters_opened

	partition Funnel = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(BaseUrl, [RelativePath = "data/warehouse/fact_monthly_funnel.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"month_start_date_key", "month_fraction_elapsed", "inquiries", "consultations_booked", "consultations_held", "letters_sent", "matters_opened"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"month_start_date_key", Int64.Type}, {"month_fraction_elapsed", type number}, {"inquiries", type number}, {"consultations_booked", type number}, {"consultations_held", type number}, {"letters_sent", type number}, {"matters_opened", type number}}, "en-US")
				in
				    Typed
