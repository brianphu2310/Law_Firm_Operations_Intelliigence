table 'Trust Balance'

	column client_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: client_key

	column month_start_date_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: month_start_date_key

	column closing_balance
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: closing_balance

	partition 'Trust Balance' = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(BaseUrl, [RelativePath = "data/warehouse/fact_trust_balance.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"client_key", "month_start_date_key", "closing_balance"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"client_key", Int64.Type}, {"month_start_date_key", Int64.Type}, {"closing_balance", type number}}, "en-US")
				in
				    Typed
