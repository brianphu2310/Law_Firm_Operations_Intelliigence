table Answers

	column Order
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Order

	column Question
		dataType: string
		summarizeBy: none
		sourceColumn: Question

	column Answer
		dataType: string
		summarizeBy: none
		sourceColumn: Answer

	column Evidence
		dataType: string
		summarizeBy: none
		sourceColumn: Evidence

	column Page
		dataType: string
		summarizeBy: none
		sourceColumn: Page

	partition Answers = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(BaseUrl, [RelativePath = "data/powerbi/answers.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"Order"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"Order", Int64.Type}, {"Question", type text}, {"Answer", type text}, {"Evidence", type text}, {"Page", type text}}, "en-US")
				in
				    Typed
