table 'Branch Period'

	column Period
		dataType: string
		summarizeBy: none
		sourceColumn: Period

	column branch
		dataType: string
		summarizeBy: none
		sourceColumn: branch

	column council
		dataType: string
		summarizeBy: none
		sourceColumn: council

	column fee_earners
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: fee_earners

	column support
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: support

	column headcount
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: headcount

	column hours
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: hours

	column util
		dataType: double
		formatString: 0.0%;-0.0%;0.0%
		summarizeBy: none
		sourceColumn: util

	column revenue
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: revenue

	column cost
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: cost

	column op_profit
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: op_profit

	column margin
		dataType: double
		formatString: 0.0%;-0.0%;0.0%
		summarizeBy: none
		sourceColumn: margin

	column active_matters
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: active_matters

	partition 'Branch Period' = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(BaseUrl, [RelativePath = "data/powerbi/branches.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"fee_earners", "support", "headcount", "hours", "util", "revenue", "cost", "op_profit", "margin", "active_matters"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"Period", type text}, {"branch", type text}, {"council", type text}, {"fee_earners", type number}, {"support", type number}, {"headcount", type number}, {"hours", type number}, {"util", type number}, {"revenue", type number}, {"cost", type number}, {"op_profit", type number}, {"margin", type number}, {"active_matters", type number}}, "en-US")
				in
				    Typed
