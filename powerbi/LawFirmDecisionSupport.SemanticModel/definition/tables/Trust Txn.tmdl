table 'Trust Txn'

	column trust_txn_key
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: trust_txn_key

	column client_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: client_key

	column txn_date_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: txn_date_key

	column txn_type
		dataType: string
		summarizeBy: none
		sourceColumn: txn_type

	column amount
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: amount

	partition 'Trust Txn' = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(BaseUrl, [RelativePath = "data/warehouse/fact_trust_txn.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"trust_txn_key", "client_key", "txn_date_key", "amount"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"trust_txn_key", Int64.Type}, {"client_key", Int64.Type}, {"txn_date_key", Int64.Type}, {"txn_type", type text}, {"amount", type number}}, "en-US")
				in
				    Typed
