table 'Practice Area'

	column practice_area_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: practice_area_key

	column practice_area
		dataType: string
		summarizeBy: none
		sourceColumn: practice_area

	partition 'Practice Area' = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(BaseUrl, [RelativePath = "data/warehouse/dim_practice_area.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"practice_area_key"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"practice_area_key", Int64.Type}, {"practice_area", type text}}, "en-US")
				in
				    Typed
