table 'Platform NPV Grid'

	column Platform
		dataType: string
		summarizeBy: none
		sourceColumn: Platform

	column Volume
		dataType: string
		summarizeBy: none
		sourceColumn: Volume
		sortByColumn: VolumeOrder

	column VolumeOrder
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: VolumeOrder

	column Realisation
		dataType: string
		summarizeBy: none
		sourceColumn: Realisation
		sortByColumn: RealisationOrder

	column RealisationOrder
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: RealisationOrder

	column NPV
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: NPV

	partition 'Platform NPV Grid' = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(BaseUrl, [RelativePath = "data/powerbi/platform_npv_grid.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"VolumeOrder", "RealisationOrder", "NPV"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"Platform", type text}, {"Volume", type text}, {"VolumeOrder", Int64.Type}, {"Realisation", type text}, {"RealisationOrder", Int64.Type}, {"NPV", type number}}, "en-US")
				in
				    Typed
