table 'FY Outlook'

	column month
		dataType: dateTime
		formatString: dd mmm yyyy
		summarizeBy: none
		sourceColumn: month

	column revenue
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: revenue

	column op_profit
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: op_profit

	column budget_rev
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: budget_rev

	column budget_op
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: budget_op

	column kind
		dataType: string
		summarizeBy: none
		sourceColumn: kind

	column MonthKey
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: MonthKey

	partition 'FY Outlook' = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(BaseUrl, [RelativePath = "data/powerbi/fy_outlook.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"month", "revenue", "op_profit", "budget_rev", "budget_op", "MonthKey"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"month", type date}, {"revenue", type number}, {"op_profit", type number}, {"budget_rev", type number}, {"budget_op", type number}, {"kind", type text}, {"MonthKey", Int64.Type}}, "en-US")
				in
				    Typed
