table 'Attorney Month'

	column attorney_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: attorney_key

	column month_start_date_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: month_start_date_key

	column month_fraction_elapsed
		dataType: double
		formatString: 0.0%;-0.0%;0.0%
		summarizeBy: none
		sourceColumn: month_fraction_elapsed

	column capacity_hours
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: capacity_hours

	column billable_hours
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: billable_hours

	column standard_value
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: standard_value

	column fees_realised
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: fees_realised

	column salary_cost
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: salary_cost

	partition 'Attorney Month' = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(BaseUrl, [RelativePath = "data/warehouse/fact_attorney_month.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"attorney_key", "month_start_date_key", "month_fraction_elapsed", "capacity_hours", "billable_hours", "standard_value", "fees_realised", "salary_cost"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"attorney_key", Int64.Type}, {"month_start_date_key", Int64.Type}, {"month_fraction_elapsed", type number}, {"capacity_hours", type number}, {"billable_hours", type number}, {"standard_value", type number}, {"fees_realised", type number}, {"salary_cost", type number}}, "en-US")
				in
				    Typed
