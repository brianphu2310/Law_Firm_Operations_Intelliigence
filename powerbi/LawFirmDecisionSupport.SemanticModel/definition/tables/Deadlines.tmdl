table Deadlines

	column date
		dataType: dateTime
		formatString: dd mmm yyyy
		summarizeBy: none
		sourceColumn: date

	column title
		dataType: string
		summarizeBy: none
		sourceColumn: title

	column court
		dataType: string
		summarizeBy: none
		sourceColumn: court

	column attorney
		dataType: string
		summarizeBy: none
		sourceColumn: attorney

	column type
		dataType: string
		summarizeBy: none
		sourceColumn: type

	column matter_id
		dataType: string
		summarizeBy: none
		sourceColumn: matter_id

	column days_from_as_of
		dataType: double
		formatString: #,0.0
		summarizeBy: none
		sourceColumn: days_from_as_of

	partition Deadlines = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(BaseUrl, [RelativePath = "data/powerbi/deadlines.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"date", "days_from_as_of"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"date", type date}, {"title", type text}, {"court", type text}, {"attorney", type text}, {"type", type text}, {"matter_id", type text}, {"days_from_as_of", type number}}, "en-US")
				in
				    Typed
