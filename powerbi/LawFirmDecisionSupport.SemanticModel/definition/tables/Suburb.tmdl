table Suburb

	column suburb_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: suburb_key

	column suburb
		dataType: string
		summarizeBy: none
		sourceColumn: suburb

	column latitude
		dataType: double
		formatString: #,0.0
		dataCategory: Latitude
		summarizeBy: none
		sourceColumn: latitude

	column longitude
		dataType: double
		formatString: #,0.0
		dataCategory: Longitude
		summarizeBy: none
		sourceColumn: longitude

	column population
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: population

	column nearest_branch_key
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: nearest_branch_key

	column km_to_nearest_branch
		dataType: double
		formatString: #,0.0
		summarizeBy: none
		sourceColumn: km_to_nearest_branch

	column Place = [suburb] & ", NSW, Australia"
		dataType: string
		dataCategory: Place
		summarizeBy: none

	column 'Distance band' = IF( [km_to_nearest_branch] <= 5, "Under 5 km", IF( [km_to_nearest_branch] <= 10, "5–10 km", "Over 10 km" ) )
		dataType: string
		summarizeBy: none
		sortByColumn: 'Band order'

	column 'Band order' = IF( [km_to_nearest_branch] <= 5, 1, IF( [km_to_nearest_branch] <= 10, 2, 3 ) )
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none

	partition Suburb = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(BaseUrl, [RelativePath = "data/warehouse/dim_suburb.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"suburb_key", "latitude", "longitude", "population", "nearest_branch_key", "km_to_nearest_branch"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"suburb_key", Int64.Type}, {"suburb", type text}, {"latitude", type number}, {"longitude", type number}, {"population", type number}, {"nearest_branch_key", Int64.Type}, {"km_to_nearest_branch", type number}}, "en-US")
				in
				    Typed
