table 'Cash Forecast'

	column week_start
		dataType: dateTime
		formatString: dd mmm yyyy
		summarizeBy: none
		sourceColumn: week_start

	column in_open
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: in_open

	column in_new
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: in_new

	column out_payroll
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: out_payroll

	column out_rent
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: out_rent

	column out_opex
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: out_opex

	column out_disb
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: out_disb

	column out_bas
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: out_bas

	column out_drawings
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: out_drawings

	column net
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: net

	column closing
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: closing

	column opening
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: opening

	column week
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: week

	column min_cash
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: min_cash

	partition 'Cash Forecast' = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(BaseUrl, [RelativePath = "data/powerbi/cash_forecast.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"week_start", "in_open", "in_new", "out_payroll", "out_rent", "out_opex", "out_disb", "out_bas", "out_drawings", "net", "closing", "opening", "week", "min_cash"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"week_start", type date}, {"in_open", type number}, {"in_new", type number}, {"out_payroll", type number}, {"out_rent", type number}, {"out_opex", type number}, {"out_disb", type number}, {"out_bas", type number}, {"out_drawings", type number}, {"net", type number}, {"closing", type number}, {"opening", type number}, {"week", Int64.Type}, {"min_cash", type number}}, "en-US")
				in
				    Typed
