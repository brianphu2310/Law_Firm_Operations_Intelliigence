table 'Monthly Extra'

	column MonthKey
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: MonthKey

	column Fraction
		dataType: double
		formatString: 0.0%;-0.0%;0.0%
		summarizeBy: none
		sourceColumn: Fraction

	column CollectionsExGST
		dataType: double
		formatString: #,0.0
		summarizeBy: none
		sourceColumn: CollectionsExGST

	column CashIn
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: CashIn

	column CashOut
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: CashOut

	column NetCash
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: NetCash

	column GSTNet
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: GSTNet

	column Drawings
		dataType: double
		formatString: #,0.0
		summarizeBy: none
		sourceColumn: Drawings

	column MattersOpened
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: MattersOpened

	column MattersClosed
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: MattersClosed

	column Searches
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: Searches

	column CouncilSearches
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: CouncilSearches

	column ActiveMatters
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: ActiveMatters

	column CashBalance
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: CashBalance

	partition 'Monthly Extra' = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(BaseUrl, [RelativePath = "data/powerbi/monthly_extra.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"MonthKey", "Fraction", "CollectionsExGST", "CashIn", "CashOut", "NetCash", "GSTNet", "Drawings", "MattersOpened", "MattersClosed", "Searches", "CouncilSearches", "ActiveMatters", "CashBalance"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"MonthKey", Int64.Type}, {"Fraction", type number}, {"CollectionsExGST", type number}, {"CashIn", type number}, {"CashOut", type number}, {"NetCash", type number}, {"GSTNet", type number}, {"Drawings", type number}, {"MattersOpened", type number}, {"MattersClosed", type number}, {"Searches", type number}, {"CouncilSearches", type number}, {"ActiveMatters", type number}, {"CashBalance", type number}}, "en-US")
				in
				    Typed
