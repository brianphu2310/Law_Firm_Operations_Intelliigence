table 'AR Ageing'

	column Period
		dataType: string
		summarizeBy: none
		sourceColumn: Period

	column Bucket
		dataType: string
		summarizeBy: none
		sourceColumn: Bucket
		sortByColumn: Order

	column Order
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Order

	column Amount
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: Amount

	partition 'AR Ageing' = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(BaseUrl, [RelativePath = "data/powerbi/ar_ageing.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"Order", "Amount"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"Period", type text}, {"Bucket", type text}, {"Order", Int64.Type}, {"Amount", type number}}, "en-US")
				in
				    Typed
