table 'Platform Scores'

	column Platform
		dataType: string
		summarizeBy: none
		sourceColumn: Platform

	column Criterion
		dataType: string
		summarizeBy: none
		sourceColumn: Criterion

	column Score
		dataType: double
		formatString: #,0.0
		summarizeBy: none
		sourceColumn: Score

	column Weight
		dataType: double
		formatString: 0.0%;-0.0%;0.0%
		summarizeBy: none
		sourceColumn: Weight

	partition 'Platform Scores' = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(BaseUrl, [RelativePath = "data/powerbi/platform_scores.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"Score", "Weight"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"Platform", type text}, {"Criterion", type text}, {"Score", type number}, {"Weight", type number}}, "en-US")
				in
				    Typed
