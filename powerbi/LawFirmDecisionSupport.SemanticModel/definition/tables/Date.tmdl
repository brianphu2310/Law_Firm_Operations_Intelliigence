table Date
	dataCategory: Time

	column date_key
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: date_key

	column full_date
		dataType: dateTime
		isKey
		formatString: dd mmm yyyy
		summarizeBy: none
		sourceColumn: full_date

	column year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: year

	column quarter
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: quarter

	column month
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: month

	column month_name
		dataType: string
		summarizeBy: none
		sourceColumn: month_name
		sortByColumn: month

	column month_start_date
		dataType: dateTime
		formatString: mmm yy
		summarizeBy: none
		sourceColumn: month_start_date

	column day_of_month
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: day_of_month

	column day_of_week
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: day_of_week

	column day_name
		dataType: string
		summarizeBy: none
		sourceColumn: day_name

	column is_weekend
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: is_weekend

	column is_month_end
		dataType: double
		formatString: #,0.0
		summarizeBy: none
		sourceColumn: is_month_end

	column fy_start_year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: fy_start_year

	column fy_label
		dataType: string
		summarizeBy: none
		sourceColumn: fy_label

	column fy_quarter
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: fy_quarter

	partition Date = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(BaseUrl, [RelativePath = "data/warehouse/dim_date.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"date_key", "full_date", "year", "quarter", "month", "month_start_date", "day_of_month", "day_of_week", "is_weekend", "is_month_end", "fy_start_year", "fy_quarter"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"date_key", Int64.Type}, {"full_date", type date}, {"year", Int64.Type}, {"quarter", Int64.Type}, {"month", Int64.Type}, {"month_name", type text}, {"month_start_date", type date}, {"day_of_month", Int64.Type}, {"day_of_week", Int64.Type}, {"day_name", type text}, {"is_weekend", type number}, {"is_month_end", type number}, {"fy_start_year", Int64.Type}, {"fy_label", type text}, {"fy_quarter", Int64.Type}}, "en-US")
				in
				    Typed
