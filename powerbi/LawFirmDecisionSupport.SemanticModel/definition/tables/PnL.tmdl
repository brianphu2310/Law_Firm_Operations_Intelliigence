table PnL

	column month_start_date_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: month_start_date_key

	column scenario_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: scenario_key

	column month_fraction_elapsed
		dataType: double
		formatString: 0.0%;-0.0%;0.0%
		summarizeBy: none
		sourceColumn: month_fraction_elapsed

	column billable_hours
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: billable_hours

	column capacity_hours
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: capacity_hours

	column standard_value
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: standard_value

	column writeoff
		dataType: double
		formatString: #,0.0
		summarizeBy: none
		sourceColumn: writeoff

	column fees
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: fees

	column disbursements_billed
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: disbursements_billed

	column revenue
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: revenue

	column payroll_fee_earners
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: payroll_fee_earners

	column disbursement_cost
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: disbursement_cost

	column payroll_support
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: payroll_support

	column rent
		dataType: double
		formatString: #,0.0
		summarizeBy: none
		sourceColumn: rent

	column software
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: software

	column insurance
		dataType: double
		formatString: #,0.0
		summarizeBy: none
		sourceColumn: insurance

	column marketing
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: marketing

	column professional_fees
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: professional_fees

	column cards
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: cards

	column merchant_fees
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: merchant_fees

	column commission
		dataType: double
		formatString: #,0.0
		summarizeBy: none
		sourceColumn: commission

	column bank_fees
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: bank_fees

	column other_costs
		dataType: double
		formatString: 0.0%;-0.0%;0.0%
		summarizeBy: none
		sourceColumn: other_costs

	column total_costs
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: total_costs

	column operating_profit
		dataType: double
		formatString: \$#,0;-\$#,0;\$0
		summarizeBy: none
		sourceColumn: operating_profit

	partition PnL = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(BaseUrl, [RelativePath = "data/warehouse/fact_monthly_pnl.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"month_start_date_key", "scenario_key", "month_fraction_elapsed", "billable_hours", "capacity_hours", "standard_value", "writeoff", "fees", "disbursements_billed", "revenue", "payroll_fee_earners", "disbursement_cost", "payroll_support", "rent", "software", "insurance", "marketing", "professional_fees", "cards", "merchant_fees", "commission", "bank_fees", "other_costs", "total_costs", "operating_profit"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"month_start_date_key", Int64.Type}, {"scenario_key", Int64.Type}, {"month_fraction_elapsed", type number}, {"billable_hours", type number}, {"capacity_hours", type number}, {"standard_value", type number}, {"writeoff", type number}, {"fees", type number}, {"disbursements_billed", type number}, {"revenue", type number}, {"payroll_fee_earners", type number}, {"disbursement_cost", type number}, {"payroll_support", type number}, {"rent", type number}, {"software", type number}, {"insurance", type number}, {"marketing", type number}, {"professional_fees", type number}, {"cards", type number}, {"merchant_fees", type number}, {"commission", type number}, {"bank_fees", type number}, {"other_costs", type number}, {"total_costs", type number}, {"operating_profit", type number}}, "en-US")
				in
				    Typed
