			VAR v_na_cost = ( v_na_on * ( ( ( ( ( v_na_pay * 190 ) * 12 ) + 9000 ) + ( ( v_na_support * 5600 ) * 12 ) ) + ( v_na_monthly * 12 ) ) )
			VAR v_area_net_full = ( ( ( ( v_na_on * v_na_mature ) * v_na_fee ) * 12 ) - v_na_cost )
			RETURN v_area_net_full
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Simulator

	measure 'Sim Area Payback' =
			VAR v_cmp = ISFILTERED( 'Sim Compare'[Compare preset] )
			VAR v_preset = IF( v_cmp, SELECTEDVALUE( 'Sim Compare'[Compare preset], "Custom" ), SELECTEDVALUE( 'Sim Preset'[Preset], "Custom" ) )
			VAR v_goal = SELECTEDVALUE( 'Sim Goal Lever'[Lever], "" )
			VAR v_goalval = SELECTEDVALUE( 'Sim Goal Step'[Hundredths], 0 ) / 100
			VAR v_D = IF( ISFILTERED( 'Sim Delivery'[Delivery] ) && HASONEVALUE( 'Sim Delivery'[Delivery] ), VALUES( 'Sim Delivery'[Delivery] ), 1 )
			VAR v_L_new_area = IF( NOT v_cmp && ISFILTERED( 'L New matter type on'[New matter type] ) && HASONEVALUE( 'L New matter type on'[Value] ), VALUES( 'L New matter type on'[Value] ), CALCULATE( SELECTEDVALUE( 'Sim Preset'[sim_new_area] ), REMOVEFILTERS( 'Sim Preset' ), 'Sim Preset'[Preset] = v_preset ) )
			VAR v_L_new_area_type = IF( NOT v_cmp && ISFILTERED( 'L Matter type'[Matter type] ) && HASONEVALUE( 'L Matter type'[Matter type] ), VALUES( 'L Matter type'[Matter type] ), CALCULATE( SELECTEDVALUE( 'Sim Preset'[sim_new_area_type] ), REMOVEFILTERS( 'Sim Preset' ), 'Sim Preset'[Preset] = v_preset ) )
			VAR v_na_on = IF( ( v_L_new_area > 0 ), 1, 0 )
			VAR v_na_fee = CALCULATE( MAX( 'Sim New Area'[Fee] ), REMOVEFILTERS( 'Sim New Area' ), 'Sim New Area'[MatterType] = v_L_new_area_type )
			VAR v_na_mature = CALCULATE( MAX( 'Sim New Area'[Mature] ), REMOVEFILTERS( 'Sim New Area' ), 'Sim New Area'[MatterType] = v_L_new_area_type )
			VAR v_na_ramp = CALCULATE( MAX( 'Sim New Area'[Ramp] ), REMOVEFILTERS( 'Sim New Area' ), 'Sim New Area'[MatterType] = v_L_new_area_type )
			VAR v_na_support = CALCULATE( MAX( 'Sim New Area'[Support] ), REMOVEFILTERS( 'Sim New Area' ), 'Sim New Area'[MatterType] = v_L_new_area_type )
			VAR v_na_monthly = CALCULATE( MAX( 'Sim New Area'[Monthly] ), REMOVEFILTERS( 'Sim New Area' ), 'Sim New Area'[MatterType] = v_L_new_area_type )
			VAR v_na_launch_cost = CALCULATE( MAX( 'Sim New Area'[Launch] ), REMOVEFILTERS( 'Sim New Area' ), 'Sim New Area'[MatterType] = v_L_new_area_type )
			VAR v_na_pay = CALCULATE( MAX( 'Sim New Area'[Pay] ), REMOVEFILTERS( 'Sim New Area' ), 'Sim New Area'[MatterType] = v_L_new_area_type )
			VAR v_na_cost = ( v_na_on * ( ( ( ( ( v_na_pay * 190 ) * 12 ) + 9000 ) + ( ( v_na_support * 5600 ) * 12 ) ) + ( v_na_monthly * 12 ) ) )
			VAR v_area_payback = IF( ( v_na_on > 0 ), MINX( FILTER( GENERATESERIES( 1, 60, 1 ), ( -v_na_launch_cost ) + ( ( v_na_mature * v_na_fee ) * v_D ) * ( MIN( [Value], INT( v_na_ramp ) ) * ( MIN( [Value], INT( v_na_ramp ) ) + 1 ) / ( 2 * v_na_ramp ) + ( [Value] - MIN( [Value], INT( v_na_ramp ) ) ) ) - ( v_na_cost / 12 ) * [Value] >= 0 ), [Value] ), BLANK() )
			RETURN v_area_payback
		formatString: 0
		displayFolder: Simulator

	measure 'Sim Area Launch' =
			VAR v_cmp = ISFILTERED( 'Sim Compare'[Compare preset] )
			VAR v_preset = IF( v_cmp, SELECTEDVALUE( 'Sim Compare'[Compare preset], "Custom" ), SELECTEDVALUE( 'Sim Preset'[Preset], "Custom" ) )
