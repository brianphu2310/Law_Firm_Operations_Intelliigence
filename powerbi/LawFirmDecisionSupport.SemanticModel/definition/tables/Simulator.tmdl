	measure 'Sim Cash Now' = 268400
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Simulator

	measure 'Sim Low Point Today' = 160138.73983471392
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Simulator

	measure 'Sim Minimum Cash' = 60000
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Simulator

	measure 'Sim Budget Profit' = 2364900.3547049034
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Simulator

	measure 'Sim Budget Margin' = 0.305643533041017
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Simulator

	measure 'Sim Today Profit' = CALCULATE( [Sim Operating Profit], REMOVEFILTERS( 'L Utilisation' ), REMOVEFILTERS( 'L Rates' ), REMOVEFILTERS( 'L Realisation' ), REMOVEFILTERS( 'L Recovery' ), REMOVEFILTERS( 'L Overheads' ), REMOVEFILTERS( 'L Days to collect' ), REMOVEFILTERS( 'L Hires' ), REMOVEFILTERS( 'L Hire role' ), REMOVEFILTERS( 'L Hire productivity' ), REMOVEFILTERS( 'L Hire area' ), REMOVEFILTERS( 'L Fee earners leaving' ), REMOVEFILTERS( 'L Leaving role' ), REMOVEFILTERS( 'L Work kept' ), REMOVEFILTERS( 'L Support cut' ), REMOVEFILTERS( 'L Years of service' ), REMOVEFILTERS( 'L Department' ), REMOVEFILTERS( 'L Support added' ), REMOVEFILTERS( 'L Fee-earner pay' ), REMOVEFILTERS( 'L Support pay' ), REMOVEFILTERS( 'L Channel' ), REMOVEFILTERS( 'L Extra marketing' ), REMOVEFILTERS( 'L New matter type on' ), REMOVEFILTERS( 'L Matter type' ), REMOVEFILTERS( 'L New branch on' ), REMOVEFILTERS( 'L Branch fee earners' ), REMOVEFILTERS( 'L Branch support' ), REMOVEFILTERS( 'L Branch rent' ), REMOVEFILTERS( 'L Branch fit-out' ), REMOVEFILTERS( 'L Branch ramp-up' ), REMOVEFILTERS( 'L Platform' ), REMOVEFILTERS( 'Sim Preset' ), REMOVEFILTERS( 'Sim Compare' ), REMOVEFILTERS( 'Sim Delivery' ), REMOVEFILTERS( 'Sim Goal Lever' ), REMOVEFILTERS( 'Sim Goal Step' ) )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Simulator

	measure 'Sim vs Today' = [Sim Operating Profit] - [Sim Today Profit]
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Simulator

	measure 'Sim vs Today %' = DIVIDE( [Sim Operating Profit] - [Sim Today Profit], ABS( [Sim Today Profit] ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Simulator

	measure 'Sim Profit Caption' = FORMAT( ROUND( [Sim vs Today %], 4 ), "▲ +0.0%;▼ -0.0%;0.0%" ) & " vs base · " & FORMAT( ROUND( [Sim vs Today], 0 ), "+$#,0;-$#,0;$0" ) & " vs today"
		displayFolder: Simulator

	measure 'Sim Margin Caption' = FORMAT( ROUND( ( [Sim Margin] - [Sim Base Margin] ) * 100, 2 ), "▲ +0.0 ""pp"";▼ -0.0 ""pp"";0.0 ""pp""" ) & " vs base · base " & FORMAT( [Sim Base Margin], "0.0%" )
		displayFolder: Simulator

	measure 'Sim Gap Caption' = "budget profit " & FORMAT( [Sim Budget Profit], "$#,0" )
		displayFolder: Simulator

	measure 'Sim Low Caption' = "today " & FORMAT( [Sim Low Point Today], "$#,0" ) & " · minimum " & FORMAT( [Sim Minimum Cash], "$#,0" )
		displayFolder: Simulator

	measure 'Sim Gap Colour' = IF( [Sim Gap to Budget] >= 0, "#047857", "#b91c1c" )
		isHidden
		displayFolder: Simulator\Format

	measure 'Sim Low Colour' = IF( [Sim Low Point] < [Sim Minimum Cash], "#b91c1c", "#0f172a" )
		isHidden
		displayFolder: Simulator\Format

	measure 'Sim Warning' =
			VAR w1 = IF( [Sim Low Point] < [Sim Minimum Cash], "This takes the account below the $60K minimum balance. Fund it first: lower partner drawings, a loan, or stage the spend. ", "" )
			VAR w2 = IF( [Sim Utilisation] > 0.95 || [Sim Team Utilisation] > 0.95, "Utilisation above about 95% is rarely sustainable: check burnout and quality risk. ", "" )
			VAR w3 = IF( [Sim Marketing Capped] = 1, "The team cannot take all the new work: the extra fees stop at 95% utilisation. Pair the campaign with a hire. ", "" )
			VAR w4 = IF( [Sim Pay Cost] <> 0 && MIN( [Sim Lever Pay FE], [Sim Lever Pay Support] ) < 3.4, "Below market wage growth (3.4%, ABS WPI): expect retention risk. Pay cuts generally need agreement and cannot go below award minimums. ", "" )
			VAR w5 = IF( [Sim Lever Fee Earners Leaving] > 0 && [Sim Fees Lost] > [Sim Cut Saving], "The fee earner(s) leaving bill more than they cost: this cut lowers profit. ", "" )
			VAR txt = w1 & w2 & w3 & w4 & w5
			RETURN IF( txt = "", "No warnings for this scenario.", txt )
		displayFolder: Simulator

	measure 'Sim Pay Rise Cost' = CALCULATE( [Sim Pay Cost], REMOVEFILTERS( 'L Utilisation' ), REMOVEFILTERS( 'L Rates' ), REMOVEFILTERS( 'L Realisation' ), REMOVEFILTERS( 'L Recovery' ), REMOVEFILTERS( 'L Overheads' ), REMOVEFILTERS( 'L Days to collect' ), REMOVEFILTERS( 'L Hires' ), REMOVEFILTERS( 'L Hire role' ), REMOVEFILTERS( 'L Hire productivity' ), REMOVEFILTERS( 'L Hire area' ), REMOVEFILTERS( 'L Fee earners leaving' ), REMOVEFILTERS( 'L Leaving role' ), REMOVEFILTERS( 'L Work kept' ), REMOVEFILTERS( 'L Support cut' ), REMOVEFILTERS( 'L Years of service' ), REMOVEFILTERS( 'L Department' ), REMOVEFILTERS( 'L Support added' ), REMOVEFILTERS( 'L Fee-earner pay' ), REMOVEFILTERS( 'L Support pay' ), REMOVEFILTERS( 'L Channel' ), REMOVEFILTERS( 'L Extra marketing' ), REMOVEFILTERS( 'L New matter type on' ), REMOVEFILTERS( 'L Matter type' ), REMOVEFILTERS( 'L New branch on' ), REMOVEFILTERS( 'L Branch fee earners' ), REMOVEFILTERS( 'L Branch support' ), REMOVEFILTERS( 'L Branch rent' ), REMOVEFILTERS( 'L Branch fit-out' ), REMOVEFILTERS( 'L Branch ramp-up' ), REMOVEFILTERS( 'L Platform' ), REMOVEFILTERS( 'Sim Preset' ), REMOVEFILTERS( 'Sim Compare' ), REMOVEFILTERS( 'Sim Delivery' ), REMOVEFILTERS( 'Sim Goal Lever' ), REMOVEFILTERS( 'Sim Goal Step' ), TREATAS( { 3 }, 'L Fee-earner pay'[Fee-earner pay change (%)] ), TREATAS( { 3 }, 'L Support pay'[Support pay change (%)] ) )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Simulator

	measure 'Sim Pay Rise Rate' = CALCULATE( [Sim Rate To Fund], REMOVEFILTERS( 'L Utilisation' ), REMOVEFILTERS( 'L Rates' ), REMOVEFILTERS( 'L Realisation' ), REMOVEFILTERS( 'L Recovery' ), REMOVEFILTERS( 'L Overheads' ), REMOVEFILTERS( 'L Days to collect' ), REMOVEFILTERS( 'L Hires' ), REMOVEFILTERS( 'L Hire role' ), REMOVEFILTERS( 'L Hire productivity' ), REMOVEFILTERS( 'L Hire area' ), REMOVEFILTERS( 'L Fee earners leaving' ), REMOVEFILTERS( 'L Leaving role' ), REMOVEFILTERS( 'L Work kept' ), REMOVEFILTERS( 'L Support cut' ), REMOVEFILTERS( 'L Years of service' ), REMOVEFILTERS( 'L Department' ), REMOVEFILTERS( 'L Support added' ), REMOVEFILTERS( 'L Fee-earner pay' ), REMOVEFILTERS( 'L Support pay' ), REMOVEFILTERS( 'L Channel' ), REMOVEFILTERS( 'L Extra marketing' ), REMOVEFILTERS( 'L New matter type on' ), REMOVEFILTERS( 'L Matter type' ), REMOVEFILTERS( 'L New branch on' ), REMOVEFILTERS( 'L Branch fee earners' ), REMOVEFILTERS( 'L Branch support' ), REMOVEFILTERS( 'L Branch rent' ), REMOVEFILTERS( 'L Branch fit-out' ), REMOVEFILTERS( 'L Branch ramp-up' ), REMOVEFILTERS( 'L Platform' ), REMOVEFILTERS( 'Sim Preset' ), REMOVEFILTERS( 'Sim Compare' ), REMOVEFILTERS( 'Sim Delivery' ), REMOVEFILTERS( 'Sim Goal Lever' ), REMOVEFILTERS( 'Sim Goal Step' ), TREATAS( { 3 }, 'L Fee-earner pay'[Fee-earner pay change (%)] ), TREATAS( { 3 }, 'L Support pay'[Support pay change (%)] ) )
		formatString: 0.0
		displayFolder: Simulator

	measure 'Sim Scenario Summary' =
			VAR v_cmp = ISFILTERED( 'Sim Compare'[Compare preset] )
			VAR v_preset = IF( v_cmp, SELECTEDVALUE( 'Sim Compare'[Compare preset], "Custom" ), SELECTEDVALUE( 'Sim Preset'[Preset], "Custom" ) )
			VAR v_goal = SELECTEDVALUE( 'Sim Goal Lever'[Lever], "" )
			VAR v_goalval = SELECTEDVALUE( 'Sim Goal Step'[Hundredths], 0 ) / 100
			VAR v_L_util = IF( v_goal = "sim_util", v_goalval, IF( NOT v_cmp && ISFILTERED( 'L Utilisation'[Utilisation (pp)] ) && HASONEVALUE( 'L Utilisation'[Utilisation (pp)] ), VALUES( 'L Utilisation'[Utilisation (pp)] ), CALCULATE( SELECTEDVALUE( 'Sim Preset'[sim_util] ), REMOVEFILTERS( 'Sim Preset' ), 'Sim Preset'[Preset] = v_preset ) ) )
			VAR v_L_rate = IF( v_goal = "sim_rate", v_goalval, IF( NOT v_cmp && ISFILTERED( 'L Rates'[Rate increase (%)] ) && HASONEVALUE( 'L Rates'[Rate increase (%)] ), VALUES( 'L Rates'[Rate increase (%)] ), CALCULATE( SELECTEDVALUE( 'Sim Preset'[sim_rate] ), REMOVEFILTERS( 'Sim Preset' ), 'Sim Preset'[Preset] = v_preset ) ) )
			VAR v_L_real = IF( v_goal = "sim_real", v_goalval, IF( NOT v_cmp && ISFILTERED( 'L Realisation'[Realisation (pp)] ) && HASONEVALUE( 'L Realisation'[Realisation (pp)] ), VALUES( 'L Realisation'[Realisation (pp)] ), CALCULATE( SELECTEDVALUE( 'Sim Preset'[sim_real] ), REMOVEFILTERS( 'Sim Preset' ), 'Sim Preset'[Preset] = v_preset ) ) )
			VAR v_L_recov = IF( v_goal = "sim_recov", v_goalval, IF( NOT v_cmp && ISFILTERED( 'L Recovery'[Disbursement recovery (pp)] ) && HASONEVALUE( 'L Recovery'[Disbursement recovery (pp)] ), VALUES( 'L Recovery'[Disbursement recovery (pp)] ), CALCULATE( SELECTEDVALUE( 'Sim Preset'[sim_recov] ), REMOVEFILTERS( 'Sim Preset' ), 'Sim Preset'[Preset] = v_preset ) ) )
			VAR v_L_infl = IF( v_goal = "sim_infl", v_goalval, IF( NOT v_cmp && ISFILTERED( 'L Overheads'[Overhead change (%)] ) && HASONEVALUE( 'L Overheads'[Overhead change (%)] ), VALUES( 'L Overheads'[Overhead change (%)] ), CALCULATE( SELECTEDVALUE( 'Sim Preset'[sim_infl] ), REMOVEFILTERS( 'Sim Preset' ), 'Sim Preset'[Preset] = v_preset ) ) )
			VAR v_L_dso = IF( NOT v_cmp && ISFILTERED( 'L Days to collect'[Days to collect] ) && HASONEVALUE( 'L Days to collect'[Days to collect] ), VALUES( 'L Days to collect'[Days to collect] ), CALCULATE( SELECTEDVALUE( 'Sim Preset'[sim_dso] ), REMOVEFILTERS( 'Sim Preset' ), 'Sim Preset'[Preset] = v_preset ) )
			VAR v_L_hires = IF( NOT v_cmp && ISFILTERED( 'L Hires'[New fee earners] ) && HASONEVALUE( 'L Hires'[New fee earners] ), VALUES( 'L Hires'[New fee earners] ), CALCULATE( SELECTEDVALUE( 'Sim Preset'[sim_hires] ), REMOVEFILTERS( 'Sim Preset' ), 'Sim Preset'[Preset] = v_preset ) )
			VAR v_L_role = IF( NOT v_cmp && ISFILTERED( 'L Hire role'[Role of the hire] ) && HASONEVALUE( 'L Hire role'[Role of the hire] ), VALUES( 'L Hire role'[Role of the hire] ), CALCULATE( SELECTEDVALUE( 'Sim Preset'[sim_role] ), REMOVEFILTERS( 'Sim Preset' ), 'Sim Preset'[Preset] = v_preset ) )
			VAR v_L_ramp = IF( NOT v_cmp && ISFILTERED( 'L Hire productivity'[Year-one productivity of a new hire] ) && HASONEVALUE( 'L Hire productivity'[Year-one productivity of a new hire] ), VALUES( 'L Hire productivity'[Year-one productivity of a new hire] ), CALCULATE( SELECTEDVALUE( 'Sim Preset'[sim_ramp] ), REMOVEFILTERS( 'Sim Preset' ), 'Sim Preset'[Preset] = v_preset ) )
			VAR v_L_hire_area = IF( NOT v_cmp && ISFILTERED( 'L Hire area'[Hire for] ) && HASONEVALUE( 'L Hire area'[Hire for] ), VALUES( 'L Hire area'[Hire for] ), CALCULATE( SELECTEDVALUE( 'Sim Preset'[sim_hire_area] ), REMOVEFILTERS( 'Sim Preset' ), 'Sim Preset'[Preset] = v_preset ) )
			VAR v_L_cut_fe = IF( NOT v_cmp && ISFILTERED( 'L Fee earners leaving'[Fee earners leaving] ) && HASONEVALUE( 'L Fee earners leaving'[Fee earners leaving] ), VALUES( 'L Fee earners leaving'[Fee earners leaving] ), CALCULATE( SELECTEDVALUE( 'Sim Preset'[sim_cut_fe] ), REMOVEFILTERS( 'Sim Preset' ), 'Sim Preset'[Preset] = v_preset ) )
			VAR v_L_cut_role = IF( NOT v_cmp && ISFILTERED( 'L Leaving role'[Role leaving] ) && HASONEVALUE( 'L Leaving role'[Role leaving] ), VALUES( 'L Leaving role'[Role leaving] ), CALCULATE( SELECTEDVALUE( 'Sim Preset'[sim_cut_role] ), REMOVEFILTERS( 'Sim Preset' ), 'Sim Preset'[Preset] = v_preset ) )
			VAR v_L_keep_work = IF( NOT v_cmp && ISFILTERED( 'L Work kept'[Work kept by the team (%)] ) && HASONEVALUE( 'L Work kept'[Work kept by the team (%)] ), VALUES( 'L Work kept'[Work kept by the team (%)] ), CALCULATE( SELECTEDVALUE( 'Sim Preset'[sim_keep_work] ), REMOVEFILTERS( 'Sim Preset' ), 'Sim Preset'[Preset] = v_preset ) )
			VAR v_L_cut_support = IF( NOT v_cmp && ISFILTERED( 'L Support cut'[Support roles cut] ) && HASONEVALUE( 'L Support cut'[Support roles cut] ), VALUES( 'L Support cut'[Support roles cut] ), CALCULATE( SELECTEDVALUE( 'Sim Preset'[sim_cut_support] ), REMOVEFILTERS( 'Sim Preset' ), 'Sim Preset'[Preset] = v_preset ) )
			VAR v_L_cut_years = IF( NOT v_cmp && ISFILTERED( 'L Years of service'[Years of service] ) && HASONEVALUE( 'L Years of service'[Years of service] ), VALUES( 'L Years of service'[Years of service] ), CALCULATE( SELECTEDVALUE( 'Sim Preset'[sim_cut_years] ), REMOVEFILTERS( 'Sim Preset' ), 'Sim Preset'[Preset] = v_preset ) )
			VAR v_L_support_dept = IF( NOT v_cmp && ISFILTERED( 'L Department'[Department] ) && HASONEVALUE( 'L Department'[Department] ), VALUES( 'L Department'[Department] ), CALCULATE( SELECTEDVALUE( 'Sim Preset'[sim_support_dept] ), REMOVEFILTERS( 'Sim Preset' ), 'Sim Preset'[Preset] = v_preset ) )
			VAR v_L_add_support = IF( NOT v_cmp && ISFILTERED( 'L Support added'[Support staff added] ) && HASONEVALUE( 'L Support added'[Support staff added] ), VALUES( 'L Support added'[Support staff added] ), CALCULATE( SELECTEDVALUE( 'Sim Preset'[sim_add_support] ), REMOVEFILTERS( 'Sim Preset' ), 'Sim Preset'[Preset] = v_preset ) )
			VAR v_L_pay_fe = IF( v_goal = "sim_pay_both", v_goalval, IF( NOT v_cmp && ISFILTERED( 'L Fee-earner pay'[Fee-earner pay change (%)] ) && HASONEVALUE( 'L Fee-earner pay'[Fee-earner pay change (%)] ), VALUES( 'L Fee-earner pay'[Fee-earner pay change (%)] ), CALCULATE( SELECTEDVALUE( 'Sim Preset'[sim_pay_fe] ), REMOVEFILTERS( 'Sim Preset' ), 'Sim Preset'[Preset] = v_preset ) ) )
			VAR v_L_pay_support = IF( v_goal = "sim_pay_both", v_goalval, IF( NOT v_cmp && ISFILTERED( 'L Support pay'[Support pay change (%)] ) && HASONEVALUE( 'L Support pay'[Support pay change (%)] ), VALUES( 'L Support pay'[Support pay change (%)] ), CALCULATE( SELECTEDVALUE( 'Sim Preset'[sim_pay_support] ), REMOVEFILTERS( 'Sim Preset' ), 'Sim Preset'[Preset] = v_preset ) ) )
			VAR v_L_mkt_channel = IF( NOT v_cmp && ISFILTERED( 'L Channel'[Marketing channel] ) && HASONEVALUE( 'L Channel'[Marketing channel] ), VALUES( 'L Channel'[Marketing channel] ), CALCULATE( SELECTEDVALUE( 'Sim Preset'[sim_mkt_channel] ), REMOVEFILTERS( 'Sim Preset' ), 'Sim Preset'[Preset] = v_preset ) )
			VAR v_L_mkt_extra = IF( NOT v_cmp && ISFILTERED( 'L Extra marketing'[Extra marketing a month] ) && HASONEVALUE( 'L Extra marketing'[Extra marketing a month] ), VALUES( 'L Extra marketing'[Extra marketing a month] ), CALCULATE( SELECTEDVALUE( 'Sim Preset'[sim_mkt_extra] ), REMOVEFILTERS( 'Sim Preset' ), 'Sim Preset'[Preset] = v_preset ) )
			VAR v_L_new_area = IF( NOT v_cmp && ISFILTERED( 'L New matter type on'[New matter type] ) && HASONEVALUE( 'L New matter type on'[Value] ), VALUES( 'L New matter type on'[Value] ), CALCULATE( SELECTEDVALUE( 'Sim Preset'[sim_new_area] ), REMOVEFILTERS( 'Sim Preset' ), 'Sim Preset'[Preset] = v_preset ) )
			VAR v_L_new_area_type = IF( NOT v_cmp && ISFILTERED( 'L Matter type'[Matter type] ) && HASONEVALUE( 'L Matter type'[Matter type] ), VALUES( 'L Matter type'[Matter type] ), CALCULATE( SELECTEDVALUE( 'Sim Preset'[sim_new_area_type] ), REMOVEFILTERS( 'Sim Preset' ), 'Sim Preset'[Preset] = v_preset ) )
			VAR v_L_branch = IF( NOT v_cmp && ISFILTERED( 'L New branch on'[New branch] ) && HASONEVALUE( 'L New branch on'[Value] ), VALUES( 'L New branch on'[Value] ), CALCULATE( SELECTEDVALUE( 'Sim Preset'[sim_branch] ), REMOVEFILTERS( 'Sim Preset' ), 'Sim Preset'[Preset] = v_preset ) )
			VAR v_L_branch_fe = IF( NOT v_cmp && ISFILTERED( 'L Branch fee earners'[Branch fee earners] ) && HASONEVALUE( 'L Branch fee earners'[Branch fee earners] ), VALUES( 'L Branch fee earners'[Branch fee earners] ), CALCULATE( SELECTEDVALUE( 'Sim Preset'[sim_branch_fe] ), REMOVEFILTERS( 'Sim Preset' ), 'Sim Preset'[Preset] = v_preset ) )
			VAR v_L_branch_support = IF( NOT v_cmp && ISFILTERED( 'L Branch support'[Branch support staff] ) && HASONEVALUE( 'L Branch support'[Branch support staff] ), VALUES( 'L Branch support'[Branch support staff] ), CALCULATE( SELECTEDVALUE( 'Sim Preset'[sim_branch_support] ), REMOVEFILTERS( 'Sim Preset' ), 'Sim Preset'[Preset] = v_preset ) )
			VAR v_L_branch_rent = IF( NOT v_cmp && ISFILTERED( 'L Branch rent'[Branch rent / month] ) && HASONEVALUE( 'L Branch rent'[Branch rent / month] ), VALUES( 'L Branch rent'[Branch rent / month] ), CALCULATE( SELECTEDVALUE( 'Sim Preset'[sim_branch_rent] ), REMOVEFILTERS( 'Sim Preset' ), 'Sim Preset'[Preset] = v_preset ) )
			VAR v_L_branch_fitout = IF( NOT v_cmp && ISFILTERED( 'L Branch fit-out'[Branch fit-out] ) && HASONEVALUE( 'L Branch fit-out'[Branch fit-out] ), VALUES( 'L Branch fit-out'[Branch fit-out] ), CALCULATE( SELECTEDVALUE( 'Sim Preset'[sim_branch_fitout] ), REMOVEFILTERS( 'Sim Preset' ), 'Sim Preset'[Preset] = v_preset ) )
			VAR v_L_branch_ramp = IF( NOT v_cmp && ISFILTERED( 'L Branch ramp-up'[Months to full productivity] ) && HASONEVALUE( 'L Branch ramp-up'[Months to full productivity] ), VALUES( 'L Branch ramp-up'[Months to full productivity] ), CALCULATE( SELECTEDVALUE( 'Sim Preset'[sim_branch_ramp] ), REMOVEFILTERS( 'Sim Preset' ), 'Sim Preset'[Preset] = v_preset ) )
			VAR v_L_platform = IF( NOT v_cmp && ISFILTERED( 'L Platform'[Platform] ) && HASONEVALUE( 'L Platform'[Platform] ), VALUES( 'L Platform'[Platform] ), CALCULATE( SELECTEDVALUE( 'Sim Preset'[sim_platform] ), REMOVEFILTERS( 'Sim Preset' ), 'Sim Preset'[Preset] = v_preset ) )
			VAR txt = IF( v_L_util <> 0, "Utilisation (pp): " & FORMAT( v_L_util, "+0.0;-0.0;0" ) & " · " )
			    & IF( v_L_rate <> 0, "Rate increase (%): " & FORMAT( v_L_rate, "+0.0;-0.0;0" ) & " · " )
			    & IF( v_L_real <> 0, "Realisation (pp): " & FORMAT( v_L_real, "+0.0;-0.0;0" ) & " · " )
			    & IF( v_L_recov <> 0, "Disbursement recovery (pp): " & FORMAT( v_L_recov, "+0.0;-0.0;0" ) & " · " )
			    & IF( v_L_infl <> 0, "Overhead change (%): " & FORMAT( v_L_infl, "+0.0;-0.0;0" ) & " · " )
			    & IF( v_L_dso <> 0, "Days to collect: " & FORMAT( v_L_dso, "+0.0;-0.0;0" ) & " · " )
			    & IF( v_L_hires <> 0, "New fee earners: " & FORMAT( v_L_hires, "0" ) & " · " )
			    & IF( v_L_role <> "Associate", "Role of the hire: " & v_L_role & " · " )
			    & IF( v_L_ramp <> 75, "Year-one productivity of a new hire: " & FORMAT( v_L_ramp, "0" ) & " · " )
			    & IF( v_L_hire_area <> "Firm mix", "Hire for: " & v_L_hire_area & " · " )
			    & IF( v_L_cut_fe <> 0, "Fee earners leaving: " & FORMAT( v_L_cut_fe, "0" ) & " · " )
			    & IF( v_L_cut_role <> "Associate", "Role leaving: " & v_L_cut_role & " · " )
			    & IF( v_L_keep_work <> 30, "Work kept by the team (%): " & FORMAT( v_L_keep_work, "0" ) & " · " )
			    & IF( v_L_cut_support <> 0, "Support roles cut: " & FORMAT( v_L_cut_support, "0" ) & " · " )
			    & IF( v_L_cut_years <> 3, "Years of service: " & FORMAT( v_L_cut_years, "0" ) & " · " )
			    & IF( v_L_support_dept <> "Reception & admin", "Department: " & v_L_support_dept & " · " )
			    & IF( v_L_add_support <> 0, "Support staff added: " & FORMAT( v_L_add_support, "0" ) & " · " )
			    & IF( v_L_pay_fe <> 0, "Fee-earner pay change (%): " & FORMAT( v_L_pay_fe, "+0.0;-0.0;0" ) & " · " )
			    & IF( v_L_pay_support <> 0, "Support pay change (%): " & FORMAT( v_L_pay_support, "+0.0;-0.0;0" ) & " · " )
			    & IF( v_L_mkt_channel <> "Website & SEO", "Marketing channel: " & v_L_mkt_channel & " · " )
			    & IF( v_L_mkt_extra <> 0, "Extra marketing a month: " & FORMAT( v_L_mkt_extra, "$#,0" ) & " · " )
			    & IF( v_L_new_area <> 0, "New matter type: " & IF( v_L_new_area > 0, "yes", "no" ) & " · " )
			    & IF( v_L_new_area_type <> "Wills & Estates", "Matter type: " & v_L_new_area_type & " · " )
			    & IF( v_L_branch <> 0, "New branch: " & IF( v_L_branch > 0, "yes", "no" ) & " · " )
			    & IF( v_L_branch_fe <> 2, "Branch fee earners: " & FORMAT( v_L_branch_fe, "0" ) & " · " )
			    & IF( v_L_branch_support <> 2, "Branch support staff: " & FORMAT( v_L_branch_support, "0" ) & " · " )
			    & IF( v_L_branch_rent <> 8000, "Branch rent / month: " & FORMAT( v_L_branch_rent, "$#,0" ) & " · " )
			    & IF( v_L_branch_fitout <> 120000, "Branch fit-out: " & FORMAT( v_L_branch_fitout, "$#,0" ) & " · " )
			    & IF( v_L_branch_ramp <> 12, "Months to full productivity: " & FORMAT( v_L_branch_ramp, "0" ) & " · " )
			    & IF( v_L_platform <> "LEAP + InfoTrack (current)", "Platform: " & v_L_platform & " · " )
			RETURN IF( txt = "", "No change: today's firm, last 12 months", LEFT( txt, LEN( txt ) - 3 ) )
		displayFolder: Simulator

	measure 'Sim Bridge Value' =
			SWITCH( SELECTEDVALUE( 'Sim Bridge Step'[Step] ),
			    "Today's profit", [Sim Base Operating Profit],
			    "Fees", [Sim Bridge Fees],
			    "Disb. recovery", [Sim Bridge Disbursements],
			    "Costs", [Sim Bridge Costs]
			)
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Simulator

	measure 'Sim Effect' =
			SWITCH( SELECTEDVALUE( 'Sim Effect Line'[Line] ),
			    "Billable hours a year", FORMAT( [Sim Base Hours], "#,0" ) & " → " & FORMAT( [Sim Hours], "#,0" ),
			    "Utilisation", FORMAT( [Sim Base Utilisation], "0.0%" ) & " → " & FORMAT( [Sim Utilisation], "0.0%" ),
			    "New hire(s): fees − cost, year one", IF( [Sim Lever Hires] > 0, FORMAT( [Sim Hire Net], "+$#,0;-$#,0" ) ),
			    "Productivity a hire needs to break even", IF( [Sim Lever Hires] > 0, FORMAT( [Sim Hire Breakeven], "0%" ) ),
			    "Support staff added: cost less fees freed", IF( [Sim Lever Support Added] > 0, FORMAT( [Sim Paralegal Fees] - [Sim Support Added Cost], "+$#,0;-$#,0" ) ),
			    "Pay review: cost a year", IF( [Sim Pay Cost] <> 0, FORMAT( -[Sim Pay Cost], "+$#,0;-$#,0" ) ),
			    "Rate increase that would pay for it", IF( [Sim Pay Cost] <> 0, IF( ISBLANK( [Sim Rate To Fund] ), "not reachable", FORMAT( [Sim Rate To Fund], "+0.0" ) & "%" ) ),
			    "Marketing: extra spend a year", IF( [Sim Marketing Spend] > 0, FORMAT( -[Sim Marketing Spend], "+$#,0;-$#,0" ) ),
			    "Extra inquiries → new matters", IF( [Sim Marketing Spend] > 0, FORMAT( [Sim Marketing Inquiries], "0" ) & " → " & FORMAT( [Sim Marketing Matters], "0" ) ),
			    "Fees from them in year one", IF( [Sim Marketing Spend] > 0, FORMAT( [Sim Marketing Fees], "+$#,0;-$#,0" ) ),
			    "New matter type: fees − costs, year one", IF( [Sim Lever New Area] > 0, FORMAT( [Sim Area Net], "+$#,0;-$#,0" ) ),
			    "New matter type at full speed, a year", IF( [Sim Lever New Area] > 0, FORMAT( [Sim Area Net Full], "+$#,0;-$#,0" ) ),
			    "Launch campaign earned back after", IF( [Sim Lever New Area] > 0, IF( ISBLANK( [Sim Area Payback] ), "not within 5 years", [Sim Area Payback] & " months" ) ),
			    "Fee earners leaving: pay saved", IF( [Sim Lever Fee Earners Leaving] > 0, FORMAT( [Sim Cut Saving], "+$#,0;-$#,0" ) ),
			    "Fees lost (after work kept)", IF( [Sim Lever Fee Earners Leaving] > 0, FORMAT( -[Sim Fees Lost], "+$#,0;-$#,0" ) ),
			    "Support roles cut: pay saved a year", IF( [Sim Lever Support Cut] > 0, FORMAT( [Sim Support Saving], "+$#,0;-$#,0" ) ),
			    "New branch: fees − costs, year one", IF( [Sim Lever Branch] > 0, FORMAT( [Sim Branch Net], "+$#,0;-$#,0" ) ),
			    "New branch at full speed, a year", IF( [Sim Lever Branch] > 0, FORMAT( [Sim Branch Net Full], "+$#,0;-$#,0" ) ),
			    "Fit-out earned back after", IF( [Sim Lever Branch] > 0, IF( ISBLANK( [Sim Branch Payback] ), "not within 5 years", [Sim Branch Payback] & " months" ) ),
			    "Platform: first-year saving", IF( [Sim Platform Annual] <> 0, FORMAT( [Sim Platform Annual], "+$#,0;-$#,0" ) ),
			    "Redundancy pay (NES)", IF( [Sim Redundancy] > 0, FORMAT( [Sim Redundancy], "$#,0" ) & " · " & [Sim Redundancy Weeks] & " weeks each" ),
			    "Notice pay", IF( [Sim Notice Pay] > 0, FORMAT( [Sim Notice Pay], "$#,0" ) & " · " & [Sim Notice Weeks] & " weeks each" ),
			    "Branch fit-out", IF( [Sim Branch Fitout] > 0, FORMAT( [Sim Branch Fitout], "$#,0" ) ),
			    "Platform migration and go-live dip", IF( [Sim Platform One-off] > 0, FORMAT( [Sim Platform One-off], "$#,0" ) ),
			    "Launch campaign", IF( [Sim Area Launch] > 0, FORMAT( [Sim Area Launch], "$#,0" ) ),
			    "Cash from collecting faster or slower", IF( [Sim DSO Cash] <> 0, FORMAT( [Sim DSO Cash], "+$#,0;-$#,0" ) ),
			    "Office account today", FORMAT( [Sim Cash Now], "$#,0" ),
			    "13-week low point: today → after", FORMAT( [Sim Low Point Today], "$#,0" ) & " → " & FORMAT( [Sim Low Point], "$#,0" ),
			    "Cash cover after the decision", FORMAT( [Sim Cash Cover], "0.0" ) & " months"
			)
		displayFolder: Simulator

	measure 'Sim Lever Effect' =
			VAR base = [Sim Today Profit]
			RETURN SWITCH( SELECTEDVALUE( 'Sim Lever Test'[Test] ),
			    "+1 pp utilisation", CALCULATE( [Sim Operating Profit], REMOVEFILTERS( 'L Utilisation' ), REMOVEFILTERS( 'L Rates' ), REMOVEFILTERS( 'L Realisation' ), REMOVEFILTERS( 'L Recovery' ), REMOVEFILTERS( 'L Overheads' ), REMOVEFILTERS( 'L Days to collect' ), REMOVEFILTERS( 'L Hires' ), REMOVEFILTERS( 'L Hire role' ), REMOVEFILTERS( 'L Hire productivity' ), REMOVEFILTERS( 'L Hire area' ), REMOVEFILTERS( 'L Fee earners leaving' ), REMOVEFILTERS( 'L Leaving role' ), REMOVEFILTERS( 'L Work kept' ), REMOVEFILTERS( 'L Support cut' ), REMOVEFILTERS( 'L Years of service' ), REMOVEFILTERS( 'L Department' ), REMOVEFILTERS( 'L Support added' ), REMOVEFILTERS( 'L Fee-earner pay' ), REMOVEFILTERS( 'L Support pay' ), REMOVEFILTERS( 'L Channel' ), REMOVEFILTERS( 'L Extra marketing' ), REMOVEFILTERS( 'L New matter type on' ), REMOVEFILTERS( 'L Matter type' ), REMOVEFILTERS( 'L New branch on' ), REMOVEFILTERS( 'L Branch fee earners' ), REMOVEFILTERS( 'L Branch support' ), REMOVEFILTERS( 'L Branch rent' ), REMOVEFILTERS( 'L Branch fit-out' ), REMOVEFILTERS( 'L Branch ramp-up' ), REMOVEFILTERS( 'L Platform' ), REMOVEFILTERS( 'Sim Preset' ), REMOVEFILTERS( 'Sim Compare' ), REMOVEFILTERS( 'Sim Delivery' ), REMOVEFILTERS( 'Sim Goal Lever' ), REMOVEFILTERS( 'Sim Goal Step' ), TREATAS( { 1 }, 'L Utilisation'[Utilisation (pp)] ) ) - base,
			    "+1% rates", CALCULATE( [Sim Operating Profit], REMOVEFILTERS( 'L Utilisation' ), REMOVEFILTERS( 'L Rates' ), REMOVEFILTERS( 'L Realisation' ), REMOVEFILTERS( 'L Recovery' ), REMOVEFILTERS( 'L Overheads' ), REMOVEFILTERS( 'L Days to collect' ), REMOVEFILTERS( 'L Hires' ), REMOVEFILTERS( 'L Hire role' ), REMOVEFILTERS( 'L Hire productivity' ), REMOVEFILTERS( 'L Hire area' ), REMOVEFILTERS( 'L Fee earners leaving' ), REMOVEFILTERS( 'L Leaving role' ), REMOVEFILTERS( 'L Work kept' ), REMOVEFILTERS( 'L Support cut' ), REMOVEFILTERS( 'L Years of service' ), REMOVEFILTERS( 'L Department' ), REMOVEFILTERS( 'L Support added' ), REMOVEFILTERS( 'L Fee-earner pay' ), REMOVEFILTERS( 'L Support pay' ), REMOVEFILTERS( 'L Channel' ), REMOVEFILTERS( 'L Extra marketing' ), REMOVEFILTERS( 'L New matter type on' ), REMOVEFILTERS( 'L Matter type' ), REMOVEFILTERS( 'L New branch on' ), REMOVEFILTERS( 'L Branch fee earners' ), REMOVEFILTERS( 'L Branch support' ), REMOVEFILTERS( 'L Branch rent' ), REMOVEFILTERS( 'L Branch fit-out' ), REMOVEFILTERS( 'L Branch ramp-up' ), REMOVEFILTERS( 'L Platform' ), REMOVEFILTERS( 'Sim Preset' ), REMOVEFILTERS( 'Sim Compare' ), REMOVEFILTERS( 'Sim Delivery' ), REMOVEFILTERS( 'Sim Goal Lever' ), REMOVEFILTERS( 'Sim Goal Step' ), TREATAS( { 1 }, 'L Rates'[Rate increase (%)] ) ) - base,
			    "+1 pp realisation", CALCULATE( [Sim Operating Profit], REMOVEFILTERS( 'L Utilisation' ), REMOVEFILTERS( 'L Rates' ), REMOVEFILTERS( 'L Realisation' ), REMOVEFILTERS( 'L Recovery' ), REMOVEFILTERS( 'L Overheads' ), REMOVEFILTERS( 'L Days to collect' ), REMOVEFILTERS( 'L Hires' ), REMOVEFILTERS( 'L Hire role' ), REMOVEFILTERS( 'L Hire productivity' ), REMOVEFILTERS( 'L Hire area' ), REMOVEFILTERS( 'L Fee earners leaving' ), REMOVEFILTERS( 'L Leaving role' ), REMOVEFILTERS( 'L Work kept' ), REMOVEFILTERS( 'L Support cut' ), REMOVEFILTERS( 'L Years of service' ), REMOVEFILTERS( 'L Department' ), REMOVEFILTERS( 'L Support added' ), REMOVEFILTERS( 'L Fee-earner pay' ), REMOVEFILTERS( 'L Support pay' ), REMOVEFILTERS( 'L Channel' ), REMOVEFILTERS( 'L Extra marketing' ), REMOVEFILTERS( 'L New matter type on' ), REMOVEFILTERS( 'L Matter type' ), REMOVEFILTERS( 'L New branch on' ), REMOVEFILTERS( 'L Branch fee earners' ), REMOVEFILTERS( 'L Branch support' ), REMOVEFILTERS( 'L Branch rent' ), REMOVEFILTERS( 'L Branch fit-out' ), REMOVEFILTERS( 'L Branch ramp-up' ), REMOVEFILTERS( 'L Platform' ), REMOVEFILTERS( 'Sim Preset' ), REMOVEFILTERS( 'Sim Compare' ), REMOVEFILTERS( 'Sim Delivery' ), REMOVEFILTERS( 'Sim Goal Lever' ), REMOVEFILTERS( 'Sim Goal Step' ), TREATAS( { 1 }, 'L Realisation'[Realisation (pp)] ) ) - base,
			    "+1% pay, everyone", CALCULATE( [Sim Operating Profit], REMOVEFILTERS( 'L Utilisation' ), REMOVEFILTERS( 'L Rates' ), REMOVEFILTERS( 'L Realisation' ), REMOVEFILTERS( 'L Recovery' ), REMOVEFILTERS( 'L Overheads' ), REMOVEFILTERS( 'L Days to collect' ), REMOVEFILTERS( 'L Hires' ), REMOVEFILTERS( 'L Hire role' ), REMOVEFILTERS( 'L Hire productivity' ), REMOVEFILTERS( 'L Hire area' ), REMOVEFILTERS( 'L Fee earners leaving' ), REMOVEFILTERS( 'L Leaving role' ), REMOVEFILTERS( 'L Work kept' ), REMOVEFILTERS( 'L Support cut' ), REMOVEFILTERS( 'L Years of service' ), REMOVEFILTERS( 'L Department' ), REMOVEFILTERS( 'L Support added' ), REMOVEFILTERS( 'L Fee-earner pay' ), REMOVEFILTERS( 'L Support pay' ), REMOVEFILTERS( 'L Channel' ), REMOVEFILTERS( 'L Extra marketing' ), REMOVEFILTERS( 'L New matter type on' ), REMOVEFILTERS( 'L Matter type' ), REMOVEFILTERS( 'L New branch on' ), REMOVEFILTERS( 'L Branch fee earners' ), REMOVEFILTERS( 'L Branch support' ), REMOVEFILTERS( 'L Branch rent' ), REMOVEFILTERS( 'L Branch fit-out' ), REMOVEFILTERS( 'L Branch ramp-up' ), REMOVEFILTERS( 'L Platform' ), REMOVEFILTERS( 'Sim Preset' ), REMOVEFILTERS( 'Sim Compare' ), REMOVEFILTERS( 'Sim Delivery' ), REMOVEFILTERS( 'Sim Goal Lever' ), REMOVEFILTERS( 'Sim Goal Step' ), TREATAS( { 1 }, 'L Fee-earner pay'[Fee-earner pay change (%)] ), TREATAS( { 1 }, 'L Support pay'[Support pay change (%)] ) ) - base,
			    "+5 pp disbursement recovery", CALCULATE( [Sim Operating Profit], REMOVEFILTERS( 'L Utilisation' ), REMOVEFILTERS( 'L Rates' ), REMOVEFILTERS( 'L Realisation' ), REMOVEFILTERS( 'L Recovery' ), REMOVEFILTERS( 'L Overheads' ), REMOVEFILTERS( 'L Days to collect' ), REMOVEFILTERS( 'L Hires' ), REMOVEFILTERS( 'L Hire role' ), REMOVEFILTERS( 'L Hire productivity' ), REMOVEFILTERS( 'L Hire area' ), REMOVEFILTERS( 'L Fee earners leaving' ), REMOVEFILTERS( 'L Leaving role' ), REMOVEFILTERS( 'L Work kept' ), REMOVEFILTERS( 'L Support cut' ), REMOVEFILTERS( 'L Years of service' ), REMOVEFILTERS( 'L Department' ), REMOVEFILTERS( 'L Support added' ), REMOVEFILTERS( 'L Fee-earner pay' ), REMOVEFILTERS( 'L Support pay' ), REMOVEFILTERS( 'L Channel' ), REMOVEFILTERS( 'L Extra marketing' ), REMOVEFILTERS( 'L New matter type on' ), REMOVEFILTERS( 'L Matter type' ), REMOVEFILTERS( 'L New branch on' ), REMOVEFILTERS( 'L Branch fee earners' ), REMOVEFILTERS( 'L Branch support' ), REMOVEFILTERS( 'L Branch rent' ), REMOVEFILTERS( 'L Branch fit-out' ), REMOVEFILTERS( 'L Branch ramp-up' ), REMOVEFILTERS( 'L Platform' ), REMOVEFILTERS( 'Sim Preset' ), REMOVEFILTERS( 'Sim Compare' ), REMOVEFILTERS( 'Sim Delivery' ), REMOVEFILTERS( 'Sim Goal Lever' ), REMOVEFILTERS( 'Sim Goal Step' ), TREATAS( { 5 }, 'L Recovery'[Disbursement recovery (pp)] ) ) - base,
			    "−1% overheads", CALCULATE( [Sim Operating Profit], REMOVEFILTERS( 'L Utilisation' ), REMOVEFILTERS( 'L Rates' ), REMOVEFILTERS( 'L Realisation' ), REMOVEFILTERS( 'L Recovery' ), REMOVEFILTERS( 'L Overheads' ), REMOVEFILTERS( 'L Days to collect' ), REMOVEFILTERS( 'L Hires' ), REMOVEFILTERS( 'L Hire role' ), REMOVEFILTERS( 'L Hire productivity' ), REMOVEFILTERS( 'L Hire area' ), REMOVEFILTERS( 'L Fee earners leaving' ), REMOVEFILTERS( 'L Leaving role' ), REMOVEFILTERS( 'L Work kept' ), REMOVEFILTERS( 'L Support cut' ), REMOVEFILTERS( 'L Years of service' ), REMOVEFILTERS( 'L Department' ), REMOVEFILTERS( 'L Support added' ), REMOVEFILTERS( 'L Fee-earner pay' ), REMOVEFILTERS( 'L Support pay' ), REMOVEFILTERS( 'L Channel' ), REMOVEFILTERS( 'L Extra marketing' ), REMOVEFILTERS( 'L New matter type on' ), REMOVEFILTERS( 'L Matter type' ), REMOVEFILTERS( 'L New branch on' ), REMOVEFILTERS( 'L Branch fee earners' ), REMOVEFILTERS( 'L Branch support' ), REMOVEFILTERS( 'L Branch rent' ), REMOVEFILTERS( 'L Branch fit-out' ), REMOVEFILTERS( 'L Branch ramp-up' ), REMOVEFILTERS( 'L Platform' ), REMOVEFILTERS( 'Sim Preset' ), REMOVEFILTERS( 'Sim Compare' ), REMOVEFILTERS( 'Sim Delivery' ), REMOVEFILTERS( 'Sim Goal Lever' ), REMOVEFILTERS( 'Sim Goal Step' ), TREATAS( { -1 }, 'L Overheads'[Overhead change (%)] ) ) - base,
			    "+1 Associate hire (50% productive)", CALCULATE( [Sim Operating Profit], REMOVEFILTERS( 'L Utilisation' ), REMOVEFILTERS( 'L Rates' ), REMOVEFILTERS( 'L Realisation' ), REMOVEFILTERS( 'L Recovery' ), REMOVEFILTERS( 'L Overheads' ), REMOVEFILTERS( 'L Days to collect' ), REMOVEFILTERS( 'L Hires' ), REMOVEFILTERS( 'L Hire role' ), REMOVEFILTERS( 'L Hire productivity' ), REMOVEFILTERS( 'L Hire area' ), REMOVEFILTERS( 'L Fee earners leaving' ), REMOVEFILTERS( 'L Leaving role' ), REMOVEFILTERS( 'L Work kept' ), REMOVEFILTERS( 'L Support cut' ), REMOVEFILTERS( 'L Years of service' ), REMOVEFILTERS( 'L Department' ), REMOVEFILTERS( 'L Support added' ), REMOVEFILTERS( 'L Fee-earner pay' ), REMOVEFILTERS( 'L Support pay' ), REMOVEFILTERS( 'L Channel' ), REMOVEFILTERS( 'L Extra marketing' ), REMOVEFILTERS( 'L New matter type on' ), REMOVEFILTERS( 'L Matter type' ), REMOVEFILTERS( 'L New branch on' ), REMOVEFILTERS( 'L Branch fee earners' ), REMOVEFILTERS( 'L Branch support' ), REMOVEFILTERS( 'L Branch rent' ), REMOVEFILTERS( 'L Branch fit-out' ), REMOVEFILTERS( 'L Branch ramp-up' ), REMOVEFILTERS( 'L Platform' ), REMOVEFILTERS( 'Sim Preset' ), REMOVEFILTERS( 'Sim Compare' ), REMOVEFILTERS( 'Sim Delivery' ), REMOVEFILTERS( 'Sim Goal Lever' ), REMOVEFILTERS( 'Sim Goal Step' ), TREATAS( { 1 }, 'L Hires'[New fee earners] ), TREATAS( { "Associate" }, 'L Hire role'[Role of the hire] ), TREATAS( { 50 }, 'L Hire productivity'[Year-one productivity of a new hire] ) ) - base,
			    "−1 support role", CALCULATE( [Sim Operating Profit], REMOVEFILTERS( 'L Utilisation' ), REMOVEFILTERS( 'L Rates' ), REMOVEFILTERS( 'L Realisation' ), REMOVEFILTERS( 'L Recovery' ), REMOVEFILTERS( 'L Overheads' ), REMOVEFILTERS( 'L Days to collect' ), REMOVEFILTERS( 'L Hires' ), REMOVEFILTERS( 'L Hire role' ), REMOVEFILTERS( 'L Hire productivity' ), REMOVEFILTERS( 'L Hire area' ), REMOVEFILTERS( 'L Fee earners leaving' ), REMOVEFILTERS( 'L Leaving role' ), REMOVEFILTERS( 'L Work kept' ), REMOVEFILTERS( 'L Support cut' ), REMOVEFILTERS( 'L Years of service' ), REMOVEFILTERS( 'L Department' ), REMOVEFILTERS( 'L Support added' ), REMOVEFILTERS( 'L Fee-earner pay' ), REMOVEFILTERS( 'L Support pay' ), REMOVEFILTERS( 'L Channel' ), REMOVEFILTERS( 'L Extra marketing' ), REMOVEFILTERS( 'L New matter type on' ), REMOVEFILTERS( 'L Matter type' ), REMOVEFILTERS( 'L New branch on' ), REMOVEFILTERS( 'L Branch fee earners' ), REMOVEFILTERS( 'L Branch support' ), REMOVEFILTERS( 'L Branch rent' ), REMOVEFILTERS( 'L Branch fit-out' ), REMOVEFILTERS( 'L Branch ramp-up' ), REMOVEFILTERS( 'L Platform' ), REMOVEFILTERS( 'Sim Preset' ), REMOVEFILTERS( 'Sim Compare' ), REMOVEFILTERS( 'Sim Delivery' ), REMOVEFILTERS( 'Sim Goal Lever' ), REMOVEFILTERS( 'Sim Goal Step' ), TREATAS( { 1 }, 'L Support cut'[Support roles cut] ) ) - base
			)
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Simulator

	/// Use with 'Sim Delivery'[Label] on the axis.
	measure 'Sim Profit at Delivery' = [Sim Operating Profit]
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Simulator

	measure 'Sim Goal Kind' = SELECTEDVALUE( 'Sim Goal Target'[Target], "FY26 budget profit" )
		isHidden
		displayFolder: Simulator\Goal

	measure 'Sim Goal Metric' = IF( [Sim Goal Kind] = "FY26 budget margin", [Sim Margin], [Sim Operating Profit] )
		isHidden
		displayFolder: Simulator\Goal

	measure 'Sim Goal Value' =
			VAR k = [Sim Goal Kind]
			RETURN SWITCH( k, "FY26 budget margin", [Sim Budget Margin],
			    "Today's profit plus extra", [Sim Today Profit] + SELECTEDVALUE( 'Sim Goal Uplift'[Extra profit a year], 0 ),
			    [Sim Budget Profit] )
		displayFolder: Simulator\Goal

	measure 'Sim Goal Caption' =
			VAR k = [Sim Goal Kind]
			VAR t = [Sim Goal Value]
			VAR c = [Sim Goal Metric]
			VAR tt = IF( k = "FY26 budget margin", FORMAT( t, "0.0%" ), FORMAT( t, "$#,0" ) )
			VAR cc = IF( k = "FY26 budget margin", FORMAT( c, "0.0%" ), FORMAT( c, "$#,0" ) )
			VAR gap = IF( c >= t, "already met", IF( k = "FY26 budget margin", FORMAT( ( t - c ) * 100, "0.0" ) & " pp short", FORMAT( t - c, "$#,0" ) & " short" ) )
			RETURN "Target: " & tt & ". Your scenario gives " & cc & " (" & gap & "). Each line moves one lever on its own, on top of your current levers."
		displayFolder: Simulator\Goal

	measure 'Sim Goal util' =
			VAR target = [Sim Goal Value]
			VAR curH = ROUND( [Sim Lever Utilisation] * 100, 0 )
			VAR x = MINX( FILTER( GENERATESERIES( curH, MAX( curH, 1400 ), 50 ), CALCULATE( [Sim Goal Metric], TREATAS( { "sim_util" }, 'Sim Goal Lever'[Lever] ), TREATAS( { [Value] }, 'Sim Goal Step'[Hundredths] ) ) >= target ), [Value] )
			RETURN IF( ISBLANK( x ), BLANK(), x / 100 )
		formatString: 0.0
		isHidden
		displayFolder: Simulator\Goal

	measure 'Sim Goal rate' =
			VAR target = [Sim Goal Value]
			VAR curH = ROUND( [Sim Lever Rate] * 100, 0 )
			VAR x = MINX( FILTER( GENERATESERIES( curH, MAX( curH, 3000 ), 50 ), CALCULATE( [Sim Goal Metric], TREATAS( { "sim_rate" }, 'Sim Goal Lever'[Lever] ), TREATAS( { [Value] }, 'Sim Goal Step'[Hundredths] ) ) >= target ), [Value] )
			RETURN IF( ISBLANK( x ), BLANK(), x / 100 )
		formatString: 0.0
		isHidden
		displayFolder: Simulator\Goal

	measure 'Sim Goal real' =
			VAR target = [Sim Goal Value]
			VAR curH = ROUND( [Sim Lever Realisation] * 100, 0 )
			VAR x = MINX( FILTER( GENERATESERIES( curH, MAX( curH, 950 ), 50 ), CALCULATE( [Sim Goal Metric], TREATAS( { "sim_real" }, 'Sim Goal Lever'[Lever] ), TREATAS( { [Value] }, 'Sim Goal Step'[Hundredths] ) ) >= target ), [Value] )
			RETURN IF( ISBLANK( x ), BLANK(), x / 100 )
		formatString: 0.0
		isHidden
		displayFolder: Simulator\Goal

	measure 'Sim Goal recov' =
			VAR target = [Sim Goal Value]
			VAR curH = ROUND( [Sim Lever Recovery] * 100, 0 )
			VAR x = MINX( FILTER( GENERATESERIES( curH, MAX( curH, 3000 ), 100 ), CALCULATE( [Sim Goal Metric], TREATAS( { "sim_recov" }, 'Sim Goal Lever'[Lever] ), TREATAS( { [Value] }, 'Sim Goal Step'[Hundredths] ) ) >= target ), [Value] )
			RETURN IF( ISBLANK( x ), BLANK(), x / 100 )
		formatString: 0.0
		isHidden
		displayFolder: Simulator\Goal

	measure 'Sim Goal infl' =
			VAR target = [Sim Goal Value]
			VAR curH = ROUND( [Sim Lever Overheads] * 100, 0 )
			VAR lo = -6000
			VAR x = MAXX( FILTER( GENERATESERIES( lo, curH, 50 ), CALCULATE( [Sim Goal Metric], TREATAS( { "sim_infl" }, 'Sim Goal Lever'[Lever] ), TREATAS( { [Value] }, 'Sim Goal Step'[Hundredths] ) ) >= target ), [Value] )
			RETURN IF( ISBLANK( x ), BLANK(), x / 100 )
		formatString: 0.0
		isHidden
		displayFolder: Simulator\Goal

	measure 'Sim Goal Required' =
			SWITCH( SELECTEDVALUE( 'Sim Goal Row'[Key] ),
			    "sim_util", [Sim Goal util],
			    "sim_rate", [Sim Goal rate],
			    "sim_real", [Sim Goal real],
			    "sim_recov", [Sim Goal recov],
			    "sim_infl", [Sim Goal infl]
			)
		formatString: 0.0
		displayFolder: Simulator\Goal

	measure 'Sim Goal Current' =
			SWITCH( SELECTEDVALUE( 'Sim Goal Row'[Key] ),
			    "sim_util", [Sim Lever Utilisation],
			    "sim_rate", [Sim Lever Rate],
			    "sim_real", [Sim Lever Realisation],
			    "sim_recov", [Sim Lever Recovery],
			    "sim_infl", [Sim Lever Overheads]
			)
		formatString: 0.0
		displayFolder: Simulator\Goal

	measure 'Sim Goal Need' =
			VAR k = SELECTEDVALUE( 'Sim Goal Row'[Key] )
			VAR r = [Sim Goal Required]
			VAR c = [Sim Goal Current]
			VAR unit = IF( k = "sim_rate" || k = "sim_infl", "%", " pp" )
			RETURN IF( ISBLANK( r ), "Not reachable on its own", IF( r = c, "Already met", FORMAT( r, "+0.0;-0.0;0.0" ) & unit & " (" & FORMAT( r - c, "+0.0;-0.0" ) & unit & " from now)" ) )
		displayFolder: Simulator\Goal

	measure 'Sim Goal Difficulty' =
			VAR k = SELECTEDVALUE( 'Sim Goal Row'[Key] )
			VAR r = [Sim Goal Required]
			VAR c = [Sim Goal Current]
			VAR lo = SWITCH( k,
			    "sim_util", -10,
			    "sim_rate", 0,
			    "sim_real", -5,
			    "sim_recov", -10,
			    "sim_infl", -10
			)
			VAR hi = SWITCH( k,
			    "sim_util", 10,
			    "sim_rate", 10,
			    "sim_real", 5,
			    "sim_recov", 10,
			    "sim_infl", 10
			)
			VAR fits = r >= lo && r <= hi
			VAR span = IF( k = "sim_infl", c - lo, hi - MAX( c, 0 ) )
			VAR share = DIVIDE( ABS( r - c ), span, 9 )
			RETURN IF( ISBLANK( r ), "Not reachable on its own", IF( r = c, "Already met", IF( fits && share <= 0.5, "Comfortable", IF( fits, "Stretch", "Beyond a realistic range" ) ) ) )
		displayFolder: Simulator\Goal

	measure 'Sim Rate To Fund' =
			VAR target = CALCULATE( [Sim Operating Profit], TREATAS( { "sim_pay_both" }, 'Sim Goal Lever'[Lever] ), TREATAS( { 0 }, 'Sim Goal Step'[Hundredths] ) )
			VAR curH = ROUND( [Sim Lever Rate] * 100, 0 )
			VAR coarse = MINX( FILTER( GENERATESERIES( curH, 3000, 50 ), CALCULATE( [Sim Operating Profit], TREATAS( { "sim_rate" }, 'Sim Goal Lever'[Lever] ), TREATAS( { [Value] }, 'Sim Goal Step'[Hundredths] ) ) >= target ), [Value] )
			VAR fine = MINX( FILTER( GENERATESERIES( MAX( curH, coarse - 50 ), coarse, 1 ), CALCULATE( [Sim Operating Profit], TREATAS( { "sim_rate" }, 'Sim Goal Lever'[Lever] ), TREATAS( { [Value] }, 'Sim Goal Step'[Hundredths] ) ) >= target ), [Value] )
			RETURN IF( ISBLANK( coarse ), BLANK(), ( fine - curH ) / 100 )
		formatString: 0.00
		displayFolder: Simulator

	measure 'Sim Compare Profit' = [Sim Operating Profit]
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Simulator\Compare

	measure 'Sim Compare vs Today' = [Sim Operating Profit] - [Sim Today Profit]
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Simulator\Compare

	measure 'Check DAX' =
			VAR p = SELECTEDVALUE( 'Sim Expected'[Preset] )
			VAR m = SELECTEDVALUE( 'Sim Expected'[Metric] )
			RETURN CALCULATE(
			    SWITCH( m,
			        "op1", [Sim Operating Profit],
			        "rev1", [Sim Revenue],
			        "cost1", [Sim Costs],
			        "one_off", [Sim One-off Cash],
			        "margin1", [Sim Margin],
			        "util1", [Sim Utilisation],
			        "low1", [Sim Low Point],
			        "op1_half_delivered", CALCULATE( [Sim Operating Profit], TREATAS( { 0.5 }, 'Sim Delivery'[Delivery] ) ),
			        "goal_rate", [Sim Goal rate],
			        "goal_util", [Sim Goal util],
			        "goal_infl", [Sim Goal infl],
			        "rate_to_fund", [Sim Rate To Fund],
			        "branch_payback", [Sim Branch Payback],
			        "area_payback", [Sim Area Payback],
			        "rank: +1 pp utilisation", CALCULATE( [Sim Lever Effect], TREATAS( { "+1 pp utilisation" }, 'Sim Lever Test'[Test] ) ),
			        "rank: +1% rates", CALCULATE( [Sim Lever Effect], TREATAS( { "+1% rates" }, 'Sim Lever Test'[Test] ) ),
			        "rank: +1 pp realisation", CALCULATE( [Sim Lever Effect], TREATAS( { "+1 pp realisation" }, 'Sim Lever Test'[Test] ) ),
			        "rank: +1% pay, everyone", CALCULATE( [Sim Lever Effect], TREATAS( { "+1% pay, everyone" }, 'Sim Lever Test'[Test] ) ),
			        "rank: +5 pp disbursement recovery", CALCULATE( [Sim Lever Effect], TREATAS( { "+5 pp disbursement recovery" }, 'Sim Lever Test'[Test] ) ),
			        "rank: −1% overheads", CALCULATE( [Sim Lever Effect], TREATAS( { "−1% overheads" }, 'Sim Lever Test'[Test] ) ),
			        "rank: +1 Associate hire (50% productive)", CALCULATE( [Sim Lever Effect], TREATAS( { "+1 Associate hire (50% productive)" }, 'Sim Lever Test'[Test] ) ),
			        "rank: −1 support role", CALCULATE( [Sim Lever Effect], TREATAS( { "−1 support role" }, 'Sim Lever Test'[Test] ) )
			    ),
			    TREATAS( { p }, 'Sim Compare'[Compare preset] ),
			    REMOVEFILTERS( 'Sim Goal Target' ), REMOVEFILTERS( 'Sim Goal Uplift' )
			)
		formatString: #,0.0000
		displayFolder: Check

	measure 'Check Python' = SUM( 'Sim Expected'[Expected] )
		formatString: #,0.0000
		displayFolder: Check

	measure 'Check Difference' = [Check DAX] - [Check Python]
		formatString: #,0.0000
		displayFolder: Check

	measure 'Check Result' =
			VAR e = [Check Python]
			VAR d = ABS( [Check Difference] )
			VAR m = SELECTEDVALUE( 'Sim Expected'[Metric] )
			VAR tol = IF( m = "rate_to_fund", 0.011, MAX( 0.5, ABS( e ) * 0.000001 ) )
			RETURN IF( ISBLANK( [Check DAX] ) && NOT ISBLANK( e ), "✗ missing", IF( d <= tol, "✓ match", "✗ differs" ) )
		displayFolder: Check

	measure 'Check Passed' =
			VAR t = ADDCOLUMNS( SUMMARIZE( 'Sim Expected', 'Sim Expected'[Preset], 'Sim Expected'[Metric] ), "r", [Check Result] )
			RETURN COUNTROWS( FILTER( t, [r] = "✓ match" ) ) & " of " & COUNTROWS( t ) & " checks match the Python engine"
		displayFolder: Check

	column Note
		dataType: string
		isHidden
		summarizeBy: none
		isNameInferred
		sourceColumn: [Note]

	partition Simulator = calculated
		mode: import
		source =
				ROW( "Note", "Simulator measures live here" )
