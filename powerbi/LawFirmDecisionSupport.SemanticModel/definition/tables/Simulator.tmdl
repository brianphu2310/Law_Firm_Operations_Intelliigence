			VAR v_L_mkt_extra = IF( NOT v_cmp && ISFILTERED( 'L Extra marketing'[Extra marketing a month] ) && HASONEVALUE( 'L Extra marketing'[Extra marketing a month] ), VALUES( 'L Extra marketing'[Extra marketing a month] ), CALCULATE( SELECTEDVALUE( 'Sim Preset'[sim_mkt_extra] ), REMOVEFILTERS( 'Sim Preset' ), 'Sim Preset'[Preset] = v_preset ) )
			VAR v_L_rate = IF( v_goal = "sim_rate", v_goalval, IF( NOT v_cmp && ISFILTERED( 'L Rates'[Rate increase (%)] ) && HASONEVALUE( 'L Rates'[Rate increase (%)] ), VALUES( 'L Rates'[Rate increase (%)] ), CALCULATE( SELECTEDVALUE( 'Sim Preset'[sim_rate] ), REMOVEFILTERS( 'Sim Preset' ), 'Sim Preset'[Preset] = v_preset ) ) )
			VAR v_L_real = IF( v_goal = "sim_real", v_goalval, IF( NOT v_cmp && ISFILTERED( 'L Realisation'[Realisation (pp)] ) && HASONEVALUE( 'L Realisation'[Realisation (pp)] ), VALUES( 'L Realisation'[Realisation (pp)] ), CALCULATE( SELECTEDVALUE( 'Sim Preset'[sim_real] ), REMOVEFILTERS( 'Sim Preset' ), 'Sim Preset'[Preset] = v_preset ) ) )
			VAR v_L_support_dept = IF( NOT v_cmp && ISFILTERED( 'L Department'[Department] ) && HASONEVALUE( 'L Department'[Department] ), VALUES( 'L Department'[Department] ), CALCULATE( SELECTEDVALUE( 'Sim Preset'[sim_support_dept] ), REMOVEFILTERS( 'Sim Preset' ), 'Sim Preset'[Preset] = v_preset ) )
			VAR v_L_util = IF( v_goal = "sim_util", v_goalval, IF( NOT v_cmp && ISFILTERED( 'L Utilisation'[Utilisation (pp)] ) && HASONEVALUE( 'L Utilisation'[Utilisation (pp)] ), VALUES( 'L Utilisation'[Utilisation (pp)] ), CALCULATE( SELECTEDVALUE( 'Sim Preset'[sim_util] ), REMOVEFILTERS( 'Sim Preset' ), 'Sim Preset'[Preset] = v_preset ) ) )
			VAR v_e_util = IF( ( v_L_util > 0 ), ( v_L_util * v_D ), v_L_util )
			VAR v_e_rate = IF( ( v_L_rate > 0 ), ( v_L_rate * v_D ), v_L_rate )
			VAR v_e_real = IF( ( v_L_real > 0 ), ( v_L_real * v_D ), v_L_real )
			VAR v_e_keep = ( v_L_keep_work * v_D )
			VAR v_util1 = ( 0.8612195064423872 + ( v_e_util / 100 ) )
			VAR v_real1 = ( 0.9073203874435393 + ( v_e_real / 100 ) )
			VAR v_rate_up = ( 1 + ( v_e_rate / 100 ) )
			VAR v_hours1 = DIVIDE( ( 15700.586175611743 * v_util1 ), 0.8612195064423872 )
			VAR v_cut_hours = ( ( ( v_L_cut_fe * 190 ) * 12 ) * v_util1 )
			VAR v_kept_hours = ( ( v_cut_hours * v_e_keep ) / 100 )
			VAR v_para_hours = IF( ( v_L_support_dept = "Paralegals & clerks" ), ( ( v_L_add_support * 200 ) * v_D ), 0 )
			VAR v_ch_spend = CALCULATE( MAX( 'Sim Channel'[Spend] ), REMOVEFILTERS( 'Sim Channel' ), 'Sim Channel'[Channel] = v_L_mkt_channel )
			VAR v_ch_cpi = CALCULATE( MAX( 'Sim Channel'[CostPerInquiry] ), REMOVEFILTERS( 'Sim Channel' ), 'Sim Channel'[Channel] = v_L_mkt_channel )
			VAR v_ch_conv = CALCULATE( MAX( 'Sim Channel'[Conversion] ), REMOVEFILTERS( 'Sim Channel' ), 'Sim Channel'[Channel] = v_L_mkt_channel )
			VAR v_ch_fpm = CALCULATE( MAX( 'Sim Channel'[FeePerMatter] ), REMOVEFILTERS( 'Sim Channel' ), 'Sim Channel'[Channel] = v_L_mkt_channel )
			VAR v_mkt_spend = ( v_L_mkt_extra * 12 )
			VAR v_mkt_inq = IF( ( v_mkt_spend > 0 ), DIVIDE( DIVIDE( ( v_mkt_spend * 0.4 ), ( 1 + DIVIDE( v_mkt_spend, v_ch_spend ) ) ), v_ch_cpi ), 0 )
			VAR v_mkt_matters = ( v_mkt_inq * v_ch_conv )
			VAR v_fees_mkt_raw = ( ( ( v_mkt_matters * v_ch_fpm ) * 0.35 ) * v_D )
			VAR v_mkt_hours_raw = DIVIDE( v_fees_mkt_raw, ( ( 491.6967936891508 * v_rate_up ) * v_real1 ) )
			VAR v_spare = MAX( 0, ( ( ( 0.95 * 17581.333333333332 ) * 1.0369318181818181 ) - ( ( v_hours1 + v_kept_hours ) + v_para_hours ) ) )
			VAR v_mkt_capped = IF( ( v_mkt_hours_raw > v_spare ), 1, 0 )
			RETURN v_mkt_capped
		formatString: 0
		displayFolder: Simulator

	measure 'Sim Area Net' =
			VAR v_cmp = ISFILTERED( 'Sim Compare'[Compare preset] )
			VAR v_preset = IF( v_cmp, SELECTEDVALUE( 'Sim Compare'[Compare preset], "Custom" ), SELECTEDVALUE( 'Sim Preset'[Preset], "Custom" ) )
			VAR v_goal = SELECTEDVALUE( 'Sim Goal Lever'[Lever], "" )
			VAR v_goalval = SELECTEDVALUE( 'Sim Goal Step'[Hundredths], 0 ) / 100
			VAR v_D = IF( ISFILTERED( 'Sim Delivery'[Delivery] ) && HASONEVALUE( 'Sim Delivery'[Delivery] ), VALUES( 'Sim Delivery'[Delivery] ), 1 )
			VAR v_L_new_area = IF( NOT v_cmp && ISFILTERED( 'L New matter type on'[New matter type] ) && HASONEVALUE( 'L New matter type on'[Value] ), VALUES( 'L New matter type on'[Value] ), CALCULATE( SELECTEDVALUE( 'Sim Preset'[sim_new_area] ), REMOVEFILTERS( 'Sim Preset' ), 'Sim Preset'[Preset] = v_preset ) )
			VAR v_L_new_area_type = IF( NOT v_cmp && ISFILTERED( 'L Matter type'[Matter type] ) && HASONEVALUE( 'L Matter type'[Matter type] ), VALUES( 'L Matter type'[Matter type] ), CALCULATE( SELECTEDVALUE( 'Sim Preset'[sim_new_area_type] ), REMOVEFILTERS( 'Sim Preset' ), 'Sim Preset'[Preset] = v_preset ) )
			VAR v_na_on = IF( ( v_L_new_area > 0 ), 1, 0 )
			VAR v_na_fee = CALCULATE( MAX( 'Sim New Area'[Fee] ), REMOVEFILTERS( 'Sim New Area' ), 'Sim New Area'[MatterType] = v_L_new_area_type )
			VAR v_na_mature = CALCULATE( MAX( 'Sim New Area'[Mature] ), REMOVEFILTERS( 'Sim New Area' ), 'Sim New Area'[MatterType] = v_L_new_area_type )
			VAR v_na_ramp = CALCULATE( MAX( 'Sim New Area'[Ramp] ), REMOVEFILTERS( 'Sim New Area' ), 'Sim New Area'[MatterType] = v_L_new_area_type )
			VAR v_na_support = CALCULATE( MAX( 'Sim New Area'[Support] ), REMOVEFILTERS( 'Sim New Area' ), 'Sim New Area'[MatterType] = v_L_new_area_type )
			VAR v_na_monthly = CALCULATE( MAX( 'Sim New Area'[Monthly] ), REMOVEFILTERS( 'Sim New Area' ), 'Sim New Area'[MatterType] = v_L_new_area_type )
			VAR v_na_pay = CALCULATE( MAX( 'Sim New Area'[Pay] ), REMOVEFILTERS( 'Sim New Area' ), 'Sim New Area'[MatterType] = v_L_new_area_type )
			VAR v_fees_na = ( ( ( ( v_na_on * ( MIN( 12, INT( v_na_ramp ) ) * ( MIN( 12, INT( v_na_ramp ) ) + 1 ) / ( 2 * v_na_ramp ) + ( 12 - MIN( 12, INT( v_na_ramp ) ) ) ) ) * v_na_mature ) * v_na_fee ) * v_D )
			VAR v_na_cost = ( v_na_on * ( ( ( ( ( v_na_pay * 190 ) * 12 ) + 9000 ) + ( ( v_na_support * 5600 ) * 12 ) ) + ( v_na_monthly * 12 ) ) )
			VAR v_area_net = ( v_fees_na - v_na_cost )
			RETURN v_area_net
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Simulator

	measure 'Sim Area Net Full' =
