			VAR v_L_real = IF( v_goal = "sim_real", v_goalval, IF( NOT v_cmp && ISFILTERED( 'L Realisation'[Realisation (pp)] ) && HASONEVALUE( 'L Realisation'[Realisation (pp)] ), VALUES( 'L Realisation'[Realisation (pp)] ), CALCULATE( SELECTEDVALUE( 'Sim Preset'[sim_real] ), REMOVEFILTERS( 'Sim Preset' ), 'Sim Preset'[Preset] = v_preset ) ) )
			VAR v_L_support_dept = IF( NOT v_cmp && ISFILTERED( 'L Department'[Department] ) && HASONEVALUE( 'L Department'[Department] ), VALUES( 'L Department'[Department] ), CALCULATE( SELECTEDVALUE( 'Sim Preset'[sim_support_dept] ), REMOVEFILTERS( 'Sim Preset' ), 'Sim Preset'[Preset] = v_preset ) )
			VAR v_e_rate = IF( ( v_L_rate > 0 ), ( v_L_rate * v_D ), v_L_rate )
			VAR v_e_real = IF( ( v_L_real > 0 ), ( v_L_real * v_D ), v_L_real )
			VAR v_real1 = ( 0.9073203874435393 + ( v_e_real / 100 ) )
			VAR v_rate_up = ( 1 + ( v_e_rate / 100 ) )
			VAR v_para_hours = IF( ( v_L_support_dept = "Paralegals & clerks" ), ( ( v_L_add_support * 200 ) * v_D ), 0 )
			VAR v_fees_para = ( ( ( v_para_hours * 491.6967936891508 ) * v_rate_up ) * v_real1 )
			RETURN v_fees_para
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Simulator

